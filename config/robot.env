# ##########################################################################
#  LocalAiRobot -- configuration (config/robot.env)
#  Sourced by scripts/run_me.sh (set -a; . config/robot.env). EVERY key also
#  has a safe default in code, so anything you omit just falls back. Edit a
#  value then re-apply to a running robot:  ./scripts/run_me.sh --reload
#  Full reference table + defaults: config/README.md
# ##########################################################################


# ==========================================================================
#   RUN MODE  --  the flags you flip most often
# ==========================================================================
ROBOT_CONCIERGE_MODE=0       # 1 = CONCIERGE MODE: a STATIONARY persona -- Jarvis NEVER drives (every move/explore/find request is politely refused with a random in-character line), introduces itself as "Jarvis the Concierge", and can ALSO be woken by a PIR motion sensor. On a motion wake it runs a strictly-LOCAL face lookup and greets known people by name (or smiles silently). ***To get the CRAWLER CAR back, just set this to 0*** (nothing else changes). Full setup + wiring: the CONCIERGE MODE section below + docs/concierge.md.
ROBOT_HALLOWEEN_MODE=0       # 1 = HALLOWEEN MODE (needs ROBOT_CONCIERGE_MODE=1 too -- it's a SUB-mode). On a PIR motion wake it SPOOKS whoever is at the door (a trick-or-treater; NO enrolment needed -- any detected face counts) with one of 50+ kid-friendly spooky phrases + a random spooky face (brain/faces/halloween/) + a cackle earcon, then chats in a spooky persona. Still 100% stationary. Set to 0 for the normal Concierge greeting. Faces: scripts/generate_halloween_faces.sh. Full flow: docs/halloween.md.
ROBOT_DRY_RUN=0              # 1 = NO hardware: driver.py swaps in fakes + logs every intended GPIO/PWM/I2C action, so you can test voice->model->hardware on an unwired Pi / laptop. ROBOT_SIMULATE is an alias.
ROBOT_FAKE_DISTANCE_CM=200   # dry-run synthetic forward distance; set <30 to make the obstacle gate trip
# Stationary / tabletop mode: run fully LIVE (wake word, voice, camera, sensors, RAG, face) but the ESC +
# steering get NO PWM -- the console still shows the throttle/steer commands (like dry-run) yet the WHEELS
# NEVER MOVE. Talk to the assembled car on a desk without it driving off. Needs ROBOT_DRY_RUN=0. 0 = normal.
ROBOT_MOTORS_OFF=0
ROBOT_LOG_LEVEL=DEBUG         # log verbosity: INFO (default) or DEBUG. run_me.sh --verbose sets DEBUG for the run.
ROBOT_POWER_MONITOR=1        # 1 (default): WARN the moment the Pi reports UNDERVOLTAGE/throttling (vcgencmd get_throttled) -- the silent cause of USB devices (mic/speaker/face) vanishing mid-run on LiPo/UBEC power -- AND log a concise draw line each poll: input volts + est. 5V-input amps + total watts (Pi 5 PMIC pmic_read_adc, per-rail V*A summed). Pi-only; a no-op on Jetson/laptop. 0 = off.
ROBOT_POWER_LOG_PERIOD_S=10  # how often the power monitor polls + logs the draw line (seconds, min 2). run_me.sh --verbose overrides this to 1 Hz and adds a per-rail V*A=W breakdown (DEBUG) -- like `watch -n1 vcgencmd pmic_read_adc`, to catch the sub-second sag of a brownout.
ROBOT_POWER_MIN_V=4.90       # Pi 5 only: log an EARLY warning when the measured input voltage (pmic_read_adc EXT5V_V) sags below this -- before get_throttled trips (the dip that precedes a brownout / frozen SSH).


# ==========================================================================
#   INSTALL-TIME FLAGS  --  read by scripts/install_stack_pi5.sh / _jetson.sh at
#   INSTALL time (NOT by the brain at runtime); they tune what the INSTALLER sets
#   up. An inline override still wins: e.g.  ROBOT_INSTALL_COMITUP=0 ./scripts/install_stack_pi5.sh
# ==========================================================================
ROBOT_INSTALL_COMITUP=1      # 1 (default): the installer sets up the Comitup captive-portal Wi-Fi FALLBACK -- when no known Wi-Fi is in range the board hosts its OWN AP + a web page to pick a network, so you can onboard from your phone with no monitor (docs/change-pi-wifi.md Tier 2). NO password is stored -- the portal collects the target Wi-Fi's password at runtime. 0 = don't install it.
ROBOT_PERSIST_JOURNAL=1      # 1 (default): the installer makes the systemd journal PERSISTENT (/var/log/journal) so the boot service's logs SURVIVE reboots -- read a past boot with `journalctl -u robot.service -b -1`. 0 = leave the journal in RAM (wiped every reboot).
ROBOT_BOOT_TO_CONSOLE=1      # 1 (default): the installer sets the boot target to the CONSOLE (multi-user.target), not the graphical desktop -- the robot is headless and its DSI/HDMI face draws to /dev/fb0, which the desktop's compositor would otherwise OWN (so the face never shows). 0 = keep the desktop. Undo later: sudo systemctl set-default graphical.target.


# ==========================================================================
#   ROBOT IDENTITY  --  the robot's own name / persona
# ==========================================================================
# What the robot calls ITSELF: it identifies as this name in speech + the LLM persona, INTRODUCES ITSELF on
# first run, and stores "who I am + what I can do" as top-priority memory in the RAG db (survives reboots).
# This is NOT the wake word -- that's a fixed openWakeWord model ('hey jarvis' unless you retrain it. Rename:
#   sed -i 's/^ROBOT_NAME=.*/ROBOT_NAME=Rosie/' config/robot.env    (the robot re-introduces itself once)
ROBOT_NAME=Jarvis


# ==========================================================================
#   BOARD SELECT  --  which single-board computer this is (Pi 5 vs Jetson)
#   Auto-detected from /proc/device-tree/model; the board picks the GPIO +
#   camera backends and the I2C bus. Add a new board in brain/boards/ (see brain/hal.py).
# ==========================================================================
ROBOT_BOARD=auto             # auto | pi5 | jetson. auto = detect the board; force it if detection is wrong.
ROBOT_I2C_BUS=               # PCA9685 I2C bus number. empty = Blinka default (Pi = bus 1). JETSON: set 7 (the 40-pin header). Requires the adafruit-extended-bus package.
ROBOT_CAMERA_BACKEND=        # empty = board default (pi5 -> picamera2, jetson -> gstreamer/CSI). Override: picamera2 | gstreamer | v4l2
#   USB WEBCAM = THE SUPPORTED CAMERA on both boards, and what the patches below set (v4l2 + OpenCV). Pick ONE:
#     Pi 5:   ./scripts/patches/pi5/3_camera_usb_webcam.sh [index]     or  .../pi5/3_camera_usb_ir_1080p.sh
#     Jetson: ./scripts/patches/jetson/3_camera_usb_webcam.sh [index]  or  .../jetson/3_camera_usb_ir_1080p.sh
#   By hand: ROBOT_CAMERA_BACKEND=v4l2 + ROBOT_CAMERA_SOURCE=0 (index; `v4l2-ctl --list-devices`) + pip install
#   opencv-python. On the Pi that means no 22->15 ribbon, no boot overlay and no vendor autofocus fork -- which
#   is why install_stack_pi5.sh defaults to ROBOT_CAMERA_OVERLAY=none. The CSI camera PATCHES were removed; the
#   picamera2/gstreamer BACKENDS still work if you set them by hand for an auto-detected official module.
ROBOT_CAMERA_SOURCE=         # v4l2: USB webcam index (e.g. 0) or a /dev/videoN path. gstreamer: a full pipeline string. empty = CSI sensor 0.
# -- JETSON pin profile (BOARD / physical-header numbering, NOT Pi BCM). scripts/install_stack_jetson.sh
#    APPLIES this for you: it sets ROBOT_BOARD=jetson + ROBOT_I2C_BUS=7 and COMMENTS OUT the six LIVE Pi BCM
#    pin lines in the OBSTACLE SENSORS section below. To do it by hand you MUST comment those six Pi lines out
#    first -- an uncommented Pi pin always wins over the board default, so leaving them live keeps the Pi
#    numbering even on a Jetson. Then uncomment + VERIFY these against the Orin Nano 40-pin pinout (free them
#    in `sudo /opt/nvidia/jetson-io/jetson-io.py`); the jetson board also supplies these same defaults. --
# ROBOT_TRIG_PIN=16       ROBOT_ECHO_PIN=18        # front  (Jetson header pins -- PLACEHOLDERS, verify!)
# ROBOT_LEFT_TRIG_PIN=29  ROBOT_LEFT_ECHO_PIN=31
# ROBOT_RIGHT_TRIG_PIN=32 ROBOT_RIGHT_ECHO_PIN=33


# ==========================================================================
#   AI BACKEND  --  where the "brain" runs: local Ollama or remote Gemini
#   Flips the text-intent model AND/OR the camera/vision model. Speech
#   (whisper STT / piper TTS), sensors, motors, face + wake word stay LOCAL
#   always. local = OFFLINE on the Pi. gemini = REMOTE (needs network +
#   an API key; camera frames leave the device). mixed = REMOTE like gemini
#   (conversation + vision) WHEN a key is present, but AUTO-FALLS-BACK to the
#   LOCAL model per-call if the network/remote is down or errors -- so it
#   never goes blank. With NO key, both gemini and mixed stay fully LOCAL.
#   Rule of thumb: conversation past a greeting goes remote unless =local
#   (or the key is missing). Setup: docs/gemini-setup.md
# ==========================================================================
ROBOT_AI_BACKEND=local          # local | gemini | mixed
# -- Remote Gemini (used when ROBOT_AI_BACKEND=gemini or =mixed, for TEXT + VISION) --
ROBOT_GEMINI_API_KEY=           # Google AI Studio key; REQUIRED for gemini/mixed; keep secret. How to get one -> docs/gemini-setup.md
# -- Remote TEXT model alternatives (must be a model your Gemini API key serves -- check your AI Studio
#    rate-limit page). Worth alternating between:
#      gemini-3.5-flash       (default: best latency/quality mix for command->JSON + chat)
#      gemini-3-flash         (previous flash; slightly cheaper on quota, still snappy)
#      gemini-3.1-pro         (smartest; noticeably slower + only ~25 RPM -- try if intents misfire)
#      gemini-3.1-flash-lite  (fastest/lightest; fine for simple drive commands, weaker chat)
#      gemini-2.5-flash       (older fallback if a 3.x model misbehaves)
#      gemma-4-26b            (hosted open-weights Gemma; LOW limits ~30 RPM/16K TPM -- text only, no vision)
#    NOT usable here: OpenAI/Anthropic/Meituan LongCat etc -- this backend speaks the GEMINI API only
#    (LongCat-2.0 is also a 1.6T-param MoE datacenter model; supporting it would need a new
#    OpenAI-compatible backend in brain/inference.py -- ask if you want that). --
ROBOT_GEMINI_MODEL=gemini-3.5-flash       # remote text/intent model -- Flash is the low-latency sweet spot for command->JSON + chat replies
ROBOT_GEMINI_VISION_MODEL=gemini-robotics-er-1.6-preview   # remote VISION model. Robotics-ER 1.6 is Google's EMBODIED-reasoning VLM (spatial reasoning, object localization, agentic navigation) -- best fit for describe/LOOK/explore/person-check. Empty -> reuse ROBOT_GEMINI_MODEL.
ROBOT_GEMINI_VISION_THINKING_BUDGET=0   # Gemini 'thinking' budget for VISION: 0 = OFF (fast + deterministic + no JSON truncation; recommended for Robotics-ER), -1 = dynamic, N = fixed, 'auto' = omit (for a model that rejects the field)
ROBOT_GEMINI_THINKING_BUDGET=0          # thinking budget for the TEXT model. 0 = OFF -- a thinking model (gemini-3.5-flash) left on its DEFAULT can spiral to 85-120s on 'should I look?' prompts and trip ROBOT_LLM_TIMEOUT_S; 0 makes command->JSON snappy + predictable. Raise (e.g. 512/1024) if intent decisions get worse; empty/'auto' = model default.
ROBOT_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta   # API base; override for a proxy/region


# ==========================================================================
#   AI STACK (LOCAL)  --  models + speech in/out + orchestration
#   whisper (STT) and piper (TTS) are ALWAYS local. ROBOT_MODEL / OLLAMA /
#   keepalive / num_ctx apply only when ROBOT_AI_BACKEND=local.
#   Replace YOUR_USER with your Linux username.
# ==========================================================================
# -- LOCAL text-model alternatives (must fit the Pi 5 16GB CPU-only + follow JSON-mode intent prompts;
#    `ollama pull <tag>` then set it here + re-source). Worth alternating between:
#      gemma4:e2b-it-qat   (default: ~2x faster than e4b, only a bit dumber -- the sweet spot on the Pi 5 CPU)
#      gemma4:e4b-it-qat   (most capable that's still usable; best REMEMBER/recall, but ~2x slower)
#      qwen3:4b            (strong small all-rounder; good JSON discipline)
#      llama3.2:3b         (fast + solid instruction following)
#      phi4-mini           (great reasoning-per-B; a bit slower than 3B peers)
#      gemma3:1b           (emergency-fast; expect flaky intent JSON -- last resort)
#    NOT viable locally: LongCat (LongCat-2.0 = 1.6T-param MoE, ~48B ACTIVE per token -- datacenter-only,
#    no small variant exists), or anything >8B (Pi 5 CPU crawls: >7B is impractical). --
ROBOT_MODEL=gemma4:e2b-it-qat   # 4-bit QAT text/intent brain (e2b = faster default; e4b is smarter but ~2x slower). vision is separate -> ROBOT_VISION_MODEL
ROBOT_OLLAMA_URL=http://localhost:11434/api/generate
ROBOT_LLM_TIMEOUT_S=120     # TOTAL model-call budget (s); raise if the first-command cold model load times out
ROBOT_LLM_RETRIES=1         # retries on a TRANSIENT network fault (e.g. 'read operation timed out' -- a stalled connection). 1 = one fresh-connection retry; 0 = off. The budget above is SPLIT across attempts, so total wall-clock stays ~ROBOT_LLM_TIMEOUT_S (no extra dead-air).
ROBOT_WHISPER_BIN=/home/YOUR_USER/whisper.cpp/build/bin/whisper-cli
ROBOT_WHISPER_MODEL=/home/YOUR_USER/whisper.cpp/models/ggml-base.en.bin
ROBOT_PIPER_BIN=/home/YOUR_USER/piper/piper/piper
ROBOT_PIPER_VOICE=/home/YOUR_USER/piper/en_US-lessac-medium.onnx
ROBOT_TTS_PRONUNCIATIONS="Ramesh=Ruh-mesh"    # phonetic respellings applied JUST before Piper speaks (whole-word, case-insensitive). Format "Name=respell; Name2=respell". Use a SINGLE joined word ("Rah-mesh"), NOT space-separated letters ("R uh m ai sh") -- Piper/espeak reads spaced single letters as the ALPHABET (R-A-M-E-S-H). Tune until it sounds right; test fast: echo "Rah-mesh" | ~/piper/piper/piper -m ~/piper/en_US-lessac-medium.onnx --output_file /tmp/t.wav && aplay /tmp/t.wav
ROBOT_MIC=plughw:CARD=Device,DEV=0    # COMMAND capture (arecord). BY NAME (not card number) so adding USB audio / a reboot can't shift it; find your id with `arecord -l`
ROBOT_RECORD_SECS=6         # seconds of audio recorded per command / follow-up. 6 (was 4): 4s clipped longer sentences mid-word. Raise for long commands; lower for snappier short ones. (Half-duplex: speech DURING the robot's reply isn't captured -- wait for it to finish.)
ROBOT_TMPDIR=/dev/shm
# -- Dedicated vision model (decouples vision latency from the text brain). Its OWN VLM, separate from
#    ROBOT_MODEL. Default 'moondream' (pulled by install_stack_pi5.sh) -- small/fast, light on the 16GB Pi. KEEP
#    SET: empty falls back to sharing ROBOT_MODEL (slower, only if THAT model can see). Switch: `ollama pull
#    <new>`, set here, re-source. --
ROBOT_VISION_MODEL=moondream
# -- Model orchestration (warmup + keep-alive + shared lock; brain/inference.py). Text-intent + vision share
#    ONE Ollama server; an in-process lock serialises them; keep-alive stops eviction between commands. --
ROBOT_WARMUP=1               # prime the model at boot so the FIRST command isn't a slow cold load
ROBOT_WARMUP_RETRY_S=90      # keep RETRYING that warmup (5s apart) for up to this many seconds. Under systemd the brain starts seconds after ollama, and ollama accepts the connection BEFORE its llama-server child is ready -- so a single attempt reliably lost the race on every boot ('HTTP 500 timed out waiting for llama-server to start') and gave up, leaving the model cold for whoever actually spoke first. 0 = one attempt only.
ROBOT_OLLAMA_KEEPALIVE=30m   # keep the model resident: '30m', '-1' = forever, '' = Ollama default (~5m)
ROBOT_NUM_CTX=4096           # cap Ollama's KV-cache context (Gemma 4 defaults to 128K -- way more than short commands need). Smaller = faster + less RAM on the Pi. 0 = Ollama default.


# ==========================================================================
#   CONVERSATION & WAKE WORD
#   "hey jarvis" opens a conversation; follow-ups then need NO wake word until
#   you go quiet. Wake word = openWakeWord, always-listening. Tuning it? Watch
#   the 'wake HEALTH' log line. Notes: docs/opnewakeword/.
# ==========================================================================
# -- Conversation follow-ups --
ROBOT_FOLLOWUP_ENABLE=1      # 1 = after a wake, keep taking commands with NO "hey jarvis" until you go silent; 0 = require the wake word every single turn (old behaviour)
ROBOT_FOLLOWUP_SILENCE_S=120  # seconds of silence mid-conversation before it sleeps (wake word needed again). Granularity is ~one record window (ROBOT_RECORD_SECS).
# -- Wake word (openWakeWord; ON by default). Wakes on ROBOT_WAKEWORD_MODEL's phrase; only STARTS a turn
#    (the EXPLORE/FIND gate is separate). Missing/unloadable .onnx -> LIVE has no trigger (brain exits);
#    ENTER/'q' work over SSH; headless (systemd) is wake-only. --
ROBOT_WAKEWORD_ENABLE=1
ROBOT_WAKEWORD_MODEL=~/LocalAiRobot/models/hey_jarvis.onnx   # stock+reliable default; custom hey_richard.onnx also in models/. missing/unloadable -> LIVE has no trigger (use --dry)
ROBOT_WAKEWORD_THRESHOLD=0.4        # 0.4 (was 0.5): some 'hey jarvis' attempts scored 0.35-0.48. ALSO check mic CLIPPING -- if `loudest` nears 32767 the score collapses; lower mic gain (amixer) so loudest sits mid-scale
ROBOT_WAKEWORD_TRIGGER_LEVEL=1      # consecutive activations before firing (raise to 2 if false-firing)
ROBOT_WAKEWORD_COOLDOWN_S=2.0       # quiet window after a wake / after TTS, before re-listening
ROBOT_WAKEWORD_DEVICE=PnP           # WAKE mic (PortAudio): a unique bit of the mic's name ("USB PnP Sound Device") -- by-name survives card renumbering; empty = default input
ROBOT_WAKEWORD_CAPTURE_RATE=0       # 0 = auto (prefer 16k native, else a CLEAN ratio 48k=3:1 / 32k=2:1, else 44.1k). Force a rate here if the mic mis-reports support. 44100 uses a costly ~8800-tap resample per chunk that can DROP audio; 48000 is a cheap 3:1 -- set 48000 if your mic supports it and auto still picks 44100.
ROBOT_WAKEWORD_QUEUE_MAX=32         # JITTER BUFFER: mic capture runs in a PortAudio callback that fills a queue this many 80ms chunks deep while predict() consumes it -- so a slow predict can't overflow the mic (the real 'went deaf' fix). Bigger = absorbs longer predict spikes before dropping a chunk, at a little worst-case wake latency. Min 4.
ROBOT_WAKEWORD_LATENCY=high         # mic input BUFFER: 'high' (device default, absorbs CPU stalls so busy loops don't drop mic samples -> no OVERFLOW/deafness), a float = seconds (e.g. 0.3), or 'low' (old tight buffer). Bigger = a touch more wake latency.
ROBOT_WAKEWORD_STREAM_RESET_S=15    # SELF-HEAL: if the mic drops chunks continuously this long (a wedged PortAudio stream), model.reset() can't fix it -> tear the stream down + reopen a fresh one. 0 disables.
ROBOT_WAKEWORD_DEGRADED_PCT=20      # HEALTH: log a 'wake DEGRADED' WARNING when >= this %% of mic chunks are dropped in a ~15s window -- the sign the predict loop can't keep up. The 'wake HEALTH:' line (dropped %) prints every ~15s regardless.
ROBOT_WAKEWORD_DROP_RESET_N=3       # MIC-01: consecutive dropped mic chunks before the wake model is RESET; single drops are BRIDGED with silence (keeps detection working on a lossy USB mic). 1 = old reset-every-drop behaviour.
ROBOT_WAKEWORD_MAX_ERRORS=10        # MIC-03: consecutive raised listen faults (USB re-enumerate / ALSA hiccup) to RETRY before giving up with a non-zero exit so systemd restarts the brain (never a silent exit-0 that leaves it deaf).
ROBOT_WAKEWORD_REBUILD_MAX_S=60     # MIC-02: if a dead mic stream can't deliver clean audio within this long, exit non-zero to restart (the only reliable recovery from a wedged USB audio stack). 0 disables the escalation (bench debugging).
ROBOT_FAKE_WAKE=0                   # dry-run: 1 = auto-fire the wake word once (else type 'r' at the prompt)


# ==========================================================================
#   AUDIO CUES / EARCONS  --  non-verbal feedback (see brain/sounds.py)
#   WAVs under <ROBOT_SOUNDS_DIR>/<folder>/, played via aplay under the same
#   half-duplex audio_lock as TTS (never garble speech). Empty dir = silent.
# ==========================================================================
ROBOT_SOUNDS_ENABLE=1
ROBOT_AUDIO_SELFHEAL=1              # 1 (default): the brain re-applies the USB-speaker ALSA default + volume at startup (runs scripts/setup_audio.sh --audio-only itself), so audio works on EVERY launch path -- systemd auto-restart, or a reboot after a brownout -- not just via run_me.sh. USB-speaker volume resets to 0 across a reboot, which otherwise silences the greeting + earcons. Pi-only in effect; best-effort. 0 = off (rely on the launcher).
ROBOT_SPEAKER_VOLUME=100            # USB-speaker MIXER level (percent, 0-100) that setup_audio.sh sets + persists, and that every launch re-applies (see ROBOT_AUDIO_SELFHEAL). 100 = the loudest the speaker's own control allows -- drop it (e.g. 60) for an indoor/desk build, keep 100 for outdoors/Halloween. Speakers with no mixer control ignore this (level fixed in hardware).
ROBOT_SOUNDS_DIR=                   # default: <repo>/sounds
ROBOT_SOUNDS_DEVICE=plughw:CARD=UACDemoV10,DEV=0   # EARCONS only (the VOICE uses the ALSA default -> ~/.asoundrc). Any USB speaker, by name (set CARD= from `aplay -l`); empty = default
ROBOT_SOUNDS_GREETING=1             # play once on boot/arm (audible "stack is up", vital headless)
ROBOT_SOUNDS_WAKE_ACK=1             # "yes?/hi" the instant the WAKE WORD fires (wake_word_ack/) -- responding to being summoned
ROBOT_SOUNDS_ACK=1                  # "got it/on it/okay" the instant a SPOKEN COMMAND is accepted (ack_sounds/); ALWAYS immediate, both backends
ROBOT_SOUNDS_REMOTE_ACK=1           # "got a remote command..." when a PHONE/HTTP command lands (remote_ack_sounds/) -- the robot audibly excuses itself
ROBOT_SOUNDS_THINKING=1             # spoken cue WHILE the model runs (thinking_sounds/): the FIRST one, picked at random
ROBOT_SOUNDS_THINKING_STILL=1       # RE-CUES after the first, each repeat interval (thinking_still_sounds/ "still..."); local only in practice
ROBOT_SOUNDS_SLEEP=1                # spoken goodbye when a CONVERSATION ends on silence (sleep_sounds/ "going back to sleep, say hey jarvis") -- plays fully, then it shows the sleeping face + waits for the wake word
ROBOT_SOUNDS_ERROR=1                # on obstacle / LLM error (fire-and-forget; never delays the stop)
# Thinking-cue TIMING is backend-aware. LOCAL is slow -> cue soon + re-cue. REMOTE is fast -> stay silent
# long enough that a normal reply plays NO cue, and if it IS slow, play just ONCE. All have safe defaults.
ROBOT_THINKING_LEAD_MS=500          # LOCAL: stay silent this long before the first thinking cue
ROBOT_THINKING_REPEAT_S=10          # LOCAL: seconds between re-cues (thinking_still_ set); 0 = play ONCE
ROBOT_THINKING_LEAD_REMOTE_MS=4000  # REMOTE: silent this long first, so a fast reply never triggers a cue
ROBOT_THINKING_REPEAT_REMOTE_S=0    # REMOTE: 0 = if a cue does fire (slow turn), play it just ONCE


# ==========================================================================
#   CAMERA & VISION
#   The supported camera is a USB (UVC) module on both boards -- either a
#   plain webcam or the 1080p IR-CUT night-vision type. It needs no boot
#   overlay and no vendor driver, so install_stack_pi5.sh defaults to
#   ROBOT_CAMERA_OVERLAY=none. Apply ONE camera patch (scripts/patches/
#   <board>/3_camera_usb_*.sh). See docs/assembly.md Phase 5.
# ==========================================================================
ROBOT_CAMERA_ENABLE=1
ROBOT_CAMERA_SIZE=768        # square letterbox target before base64 (keeps the VLM to one image crop). IT ALSO CAPS FACE RECOGNITION: face_id sees this exact frame, so a visitor's face is only ever (their share of the frame width) x this many pixels. At 512 a wall-mounted concierge measured 70px faces against enrolment photos at 126-212px, and match scores sat marginally at 0.25-0.40. 768 takes the same visitor to ~105px and costs 2.25x the bytes on each Gemini upload -- worth it for a CONCIERGE (recognition is its whole job), less so for the crawler. Raise ROBOT_CAMERA_CAPTURE_WIDTH/HEIGHT with it, or you are just upscaling the same detail.
ROBOT_CAMERA_CAPTURE_WIDTH=1280  # USB webcam / v4l2 ONLY: the sensor mode to ASK the camera for. This used to be left to the driver, and virtually every UVC webcam defaults to 640x480 -- which silently capped face recognition, because the recogniser only ever sees (the face's share of the frame width) x ROBOT_CAMERA_SIZE pixels and ArcFace needs real detail to fill its 112x112 aligned crop. A wall-mounted concierge measured 70px faces and match scores of 0.25-0.40, against enrolment photos whose faces were 126-212px: same person, same model, less to work with. A camera that can't do the requested mode gives its nearest one, and the startup line reports what it ACTUALLY got. 0 = don't ask, take the driver default (the old behaviour).
ROBOT_CAMERA_CAPTURE_HEIGHT=720  # ...the other half of that mode. 1280x720 is the safe near-universal choice; 1920x1080 gives more detail again if your webcam does it at a usable frame rate (each capture reads several frames, so a 5fps 1080p mode would make every look slow).
ROBOT_CAMERA_WARMUP_S=1.0    # let auto-exposure / white-balance settle before the capture (CSI/Picamera2 path)
ROBOT_CAMERA_DISCARD_FRAMES=5 # USB webcam / v4l2 ONLY. Frames to read and THROW AWAY before keeping one, on a COLD capture (the first, or the first after a gap). A V4L2 driver hands back whatever is queued -- which can be seconds stale -- and auto-exposure hasn't settled, so several reads are the only way to get a frame that is both CURRENT and correctly exposed. This is also the single biggest per-frame cost: on the field robot capture dominated at ~400ms/frame.
ROBOT_CAMERA_DISCARD_FRAMES_WARM=1 # ...and how many to discard when the LAST capture was under ROBOT_CAMERA_WARM_WINDOW_S ago -- i.e. inside a Concierge recognition burst. The stream is already running, AE/AWB settled on the previous frame and the queue is one deep (the backend also asks for CAP_PROP_BUFFERSIZE=1), so re-discarding 5 buys nothing and costs a frame interval each. A 35-look recognition window was spending most of its time throwing away good frames. Set this EQUAL to ROBOT_CAMERA_DISCARD_FRAMES to restore the old uniform behaviour exactly; raise it to 2-3 if burst frames come back visibly stale or badly exposed.
ROBOT_CAMERA_WARM_WINDOW_S=2.0 # how recently the previous capture must have been for the next one to count as WARM. Comfortably longer than the recognition window's per-frame interval, comfortably shorter than the gap between two separate motion wakes.
ROBOT_CAMERA_AUTOFOCUS=1     # autofocus, on BOTH camera backends (they steer it very differently -- check the startup log line, which now always states the focus mode it ended up in). USB webcam/v4l2 (the supported path): sets the UVC CAP_PROP_AUTOFOCUS control; many webcams expose no software focus control at all, and the log then says 'autofocus=firmware default' (inspect it with: v4l2-ctl -d <N> --list-ctrls). SET THIS TO 0 for a fixed-lens module -- the 1080p IR night-vision boards have a fixed 3.6mm lens with enough depth of field that 1-3m is sharp, and its patch sets 0 for you. Picamera2: puts an AF-capable sensor in Auto and runs a one-shot focus before a capture; if the sensor exposes no AfMode the log WARNS and says FIXED-FOCUS.
ROBOT_CAMERA_AF_MIN_INTERVAL_S=3 # CSI/Picamera2 ONLY (a USB webcam's AF is paced by its own firmware -- we never call a blocking focus cycle there). Reuse a focus lock for this many seconds before scanning again. An AF cycle BLOCKS 0.3-1s, and the Concierge recognition window grabs a burst of stills ~0.25s apart -- re-focusing every frame would spend 5-18s hunting the lens inside a 5s window (the burst never finishes) to re-focus on a scene that hasn't moved. So it focuses on the first frame of a burst and reuses the lock. 0 = focus before EVERY capture.
ROBOT_WAKE_PERSON_CHECK=auto # on wake, snap + VLM-check if a PERSON is in front (runs PARALLEL to the command recording -> ~free on REMOTE) and feed it into that turn's reply. auto = ON for remote, OFF for local (a slow local VLM would just delay the command); 1 = always, 0 = never.
ROBOT_VISION_TIMEOUT_S=600        # LOCAL Ollama vision budget (s) -- the Pi 5 CPU image call is SLOW (tens of s to minutes). Used only when ROBOT_AI_BACKEND=local.
ROBOT_VISION_TIMEOUT_REMOTE_S=45  # REMOTE (Gemini) vision budget (s). Remote vision normally returns in seconds; this SHORT cap makes a HUNG call (e.g. a stalled gemini-robotics-er request) fail fast and free LOOK/explore, instead of freezing for the local 600s. Split across ROBOT_LLM_RETRIES attempts.
ROBOT_FAKE_VISION=           # dry-run scripted sighting "target:horizontal:distance:confidence" (e.g. sofa:left:near:0.9)


# ==========================================================================
#   CONCIERGE MODE  --  stationary assistant (ROBOT_CONCIERGE_MODE=1, top of file)
#   PIR motion wake + STRICTLY-LOCAL face recognition (cv2 detect + ArcFace ONNX via onnxruntime, matched
#   against faces enrolled in the RAG db). All keys below are IGNORED unless ROBOT_CONCIERGE_MODE=1.
#   The model + deps are installed by scripts/install_stack_pi5.sh / _jetson.sh (like the other models); then
#   just enrol people:  ./scripts/enroll_person.sh "Ramesh" "desc" "say-as" photo.jpg  (say-as="" -> greet by name; or --camera; re-provision: scripts/provision_face_id.sh)
#   🎃 HALLOWEEN sub-mode: also set ROBOT_HALLOWEEN_MODE=1 (top of file) to SPOOK trick-or-treaters instead
#   of greeting -- no enrolment needed (any detected face). See docs/halloween.md.
# ==========================================================================
ROBOT_WAKE_SENSOR=pir        # WHICH sensor tells the Concierge someone arrived. 'pir' is the only value that ships, and it means ANY digital-pin motion sensor on ROBOT_PIR_PIN -- from a few-pound HC-SR501 to an industrial Panasonic PaPIRs. brain/pir.py only ever reads a HIGH/LOW, so which one you buy is wiring and numbers, never code: pick yours with scripts/patches/common/6_motion_pir_hcsr501.sh or 6_motion_pir_papirs.sh (they write the same key SET with different values, so switching either way is complete). The key exists as an extension point -- a future sensor with a genuinely different interface plugs in at one place in brain/main.py -- and anything unrecognised logs a warning and falls back to 'pir'. WORTH KNOWING WHEREVER YOU MOUNT IT: a PIR is passive, so it fires when a warm body CROSSES between its detection zones, which makes walking STRAIGHT AT it the worst case. On the reference build 12 deliberate head-on approaches produced 1-3 detections with sensitivity at MAX and delay at MIN, while the same sensor gave 12/12 across its field, and a heated room plus winter clothing makes it worse again (both cut the thermal contrast a PIR depends on). Aim it ACROSS the traffic, not down the approach lane.
ROBOT_PIR_PIN=4            # PIR motion-sensor OUT pin. DEFAULT = Pi BCM GPIO4 (physical pin 7) -- free in BOTH the HC-SR04 and VL53L1X builds. WIRING: OUT->GPIO4 (pin 7), VCC->5V (pin 2), GND->GND (pin 6). Power VCC from 5V -- NOT 3.3V (a PIR on the 3.3V rail typically won't trigger); only the OUT line is 3.3V logic -> Pi-safe (no divider). gpiozero pulls this input DOWN, so an UNWIRED pin won't false-trigger. Probe it: ./scripts/pir_sensor_probe.sh. Wiring guide: docs/wiring/pir-sensor-wiring.md. Empty = motion wake OFF (wake word only). Jetson = BOARD-header pin.
ROBOT_PIR_WARMUP_S=0         # IGNORE the sensor's output for this long after startup. A PIR's pyroelectric front-end is UNDEFINED while it settles and can toggle on its own -- and since the brain boots at that exact moment, those are the least useful wakes of the run. 0 (default) suits an HC-SR501, which settles in a couple of seconds and whose stray edges the Stage-A probe kills anyway. *** SET 30 FOR A PANASONIC PaPIRs (EKMC/EKMB) *** -- its datasheet specifies up to 30s of undefined output. The count appears in the shutdown summary as "(warm-up)".
ROBOT_PIR_PRESENCE_HOLD_S=5  # HOW LONG A PULSE COUNTS AS ONGOING PRESENCE. A PIR output is a PULSE TRAIN, not a level: the SEN0171 latches HIGH ~2.3-3s per trigger, drops LOW, then re-triggers while the person keeps moving. The indicator LED follows it and the gaps are too short to see, so it looks solidly on -- but a bare pin read sampled inside a gap returns False. That mismatch is why the concierge used to give up with the sensor apparently still lit: a 41-give-up field log had EVERY Stage A loop end on a pin read (never on the safety watchdog), at 4.1-12.1s. So presence is STICKY -- HIGH now, or HIGH within this many seconds. This only has to outlast the GAP BETWEEN pulses, not a whole visit: each new pulse re-stamps it, so a person who stays extends it indefinitely while one who leaves expires a single window after their last pulse. Raise it if the robot still stops while you are standing there; lower it if it keeps looking after people have gone. 0 = bare pin read (the old, wrong behaviour).
ROBOT_PIR_PULL=down          # internal resistor on the PIR's OUT pin. down (default) = an UNWIRED pin reads LOW instead of floating and inventing motion -- right for push-pull modules like the HC-SR501. none = no pull at all: use it for parts whose datasheet demands a HIGH-IMPEDANCE load, e.g. Panasonic PaPIRs caps its output at 100uA while the Pi's ~50k pull-down already draws ~66uA at 3.3V -- inside the budget but tight, and it can drag the HIGH level down. up = for an ACTIVE-LOW open-collector "alarm" output (e.g. SparkFun SEN-13285), which idles high and pulls low on motion.
ROBOT_PIR_HOLD_S=0.1       # PIR NOISE FILTER: after a trigger, re-read the pin this many seconds later; if it has ALREADY fallen it was an electrical spike, not a person, so ignore it. IT IS ALSO PURE LATENCY -- the sleep happens on EVERY accepted edge, before the camera is even asked, so it is added to every greeting. Lowered 0.25 -> 0.1 on evidence: across every field run to date the "noise spikes" counter in the shutdown summary read ZERO, i.e. no edge has ever fallen inside the window, so 250ms was being paid for a filter that never fires on this hardware. Raise it again if `PIR GPIO n: ... + N (noise spikes)` starts showing a non-zero N. 0 = trust every edge (no filter, no delay).
ROBOT_PIR_COOLDOWN_S=2       # PIR EDGE DEBOUNCE (was 15): ignore further edges for this many seconds after an accepted one, so ONE sensor pulse train is ONE wake. This is NO LONGER the rate limiter -- the two ROBOT_CONCIERGE_*_COOLDOWN_S keys below are, and they are applied AFTER the camera has looked. Why it changed: a 19-hour field log showed the sensor offering an edge every ~7s round the clock, so a 15s blind cooldown meant 205 wakes/hour x 15s = 85% of every hour STRUCTURALLY DEAF to a new arrival -- a real visitor waited a random 0-15s before the camera even opened, by which time they had turned away and the recognition window saw nothing. That was the "the PIR doesn't wake it 90% of the time" bug: not too few triggers, too much blind throttle. 0 = react to every edge.
ROBOT_CONCIERGE_SILENT_COOLDOWN_S=4 # OUTCOME COOLDOWN after a look that found NOBODY. The real idle rate limiter -- unlike the old edge cooldown it is applied WITH evidence, so it throttles a lying sensor without throttling real visitors. BUT IT IS STILL DEAF TIME: a visitor arriving inside it waits for it to expire. Measured on a 17-min field run, silent probes landed every ~14s, so at 8s the robot was dropping a new arrival 46% of the time; at 4s that halves to ~23%, and each extra probe now costs far less than it used to (see ROBOT_CAMERA_DISCARD_FRAMES_WARM). Lower it further for a snappier greeter on a chattery sensor, raise it to spare CPU. 0 = no silent cooldown (look at every accepted edge).
ROBOT_CONCIERGE_GREET_COOLDOWN_S=60 # OUTCOME COOLDOWN after Jarvis actually GREETS someone (or spooks them in Halloween Mode): don't re-greet on motion for this long. The visitor is standing right in front of the sensor, so without this every wave of their arm re-triggers the greeting they are already in the middle of -- the field log shows the same person greeted twice, 30 seconds apart. Lower it if two different people often arrive back-to-back. 0 = no greet cooldown.
ROBOT_CONCIERGE_PROBE_TRIES=4 # STAGE A -- how many cheap ONE-FRAME "is anyone actually there?" looks to take the moment motion fires, before committing to the full recognition window. It returns early on the first hit, so a real visitor costs ONE frame. This is what makes the low debounce above affordable: 98.8% of motion wakes in the field log had nobody in front of the camera, and answering those with the full ~15-frame burst is what forced the old blind cooldown in the first place. Idle detector work drops ~6,150/hour -> ~500/hour even though the robot now looks 2.4x more often. 0 = skip Stage A and always run the full window (the old behaviour).
ROBOT_CONCIERGE_PROBE_INTERVAL_S=0.3 # pause between those Stage-A looks. Short on purpose: it is there to catch a visitor mid-stride, not to wait for one to arrive (that is the recognition window's job).
ROBOT_CONCIERGE_PROBE_MAX_S=20   # STAGE A CEILING for keep-looking-while-the-sensor-still-says-someone-is-there. A fixed frame budget has to GUESS how long an approach takes, and guesses the same for a visitor already at the door and one who tripped the sensor 4m out -- but a PIR holds its output HIGH while it keeps re-triggering (the SEN0171 latches ~2.3-3s per trigger), so Stage A can just keep asking the sensor instead. ROBOT_CONCIERGE_PROBE_TRIES stays the FLOOR (always taken, since the output can fall while someone is still walking in) and this is the ceiling. NOT optional paranoia: a PIR stuck HIGH -- failed part, or a heat source parked in frame -- would otherwise pin the camera at 100% forever, which is the exact runaway the two-stage design exists to prevent. 0 = disable and use the fixed budget only.
ROBOT_CONCIERGE_SMILE_HOLD_S=5 # HOW LONG THE SMILE OUTLASTS THE SENSOR. Defaults to the same window as ROBOT_PIR_PRESENCE_HOLD_S, so the face is up exactly while the robot is still looking. It was 1.5s on the theory that it only had to bridge the gap between a PIR output pulse train -- but 2,576 measured ticks put those gaps at p75 2.69s / p90 4.48s / p95 5.08s, so 1.5s showed idle on 28.6% of ticks WHILE a look was still running, which is precisely the "green face goes off while the blue LED is on" complaint. At 5s that is 0%. Lower it if the smile lingers after people leave -- and check the cost first with ROBOT_SENSOR_VERBOSE=1, whose PIR tick lines are a software oscilloscope of the pin.
ROBOT_CONCIERGE_RECOGNIZE_MAX_S=45 # STAGE B safety stop for the same whichever-lasts-longer rule. ROBOT_CONCIERGE_RECOGNIZE_S is the FLOOR (always run at least that long -- a visitor can step out of the sensor zones while still walking toward the camera); past it, keep RECOGNISING for as long as the sensor says somebody is there, up to this cap. Giving up while the sensor is still asserting is the one outcome that is never right: it is the robot deciding nobody is there while its own sensor disagrees. The cap bounds a stuck-HIGH sensor to one long window per wake, after which the outcome cooldown takes over. 0 = fixed window only (the old behaviour).
ROBOT_CONCIERGE_SMILE_ON_MOTION=1 # 1 = smile the INSTANT motion fires, before the camera has confirmed anyone (a greeter that waits to be sure before acknowledging you feels broken). 0 = hold the smile until Stage A has actually SEEN somebody -- about 0.3s later, and then only for real visitors. Worth setting to 0 if the PIR chatters: the sensor is now answered ~2.4x more often than under the old blind cooldown, so at 1 an empty room gets a brief happy flash every few seconds all night.
ROBOT_CONCIERGE_GREET_ONLY=0 # 1 = DROP THE SPOKEN GOODBYE. The follow-up conversation still happens exactly as before -- Jarvis greets, listens, and chats if you talk to it -- but when the follow-up window finally times out after ROBOT_FOLLOWUP_SILENCE_S it just goes quiet instead of saying "Okay, chat later." / "Okay, see ya." The greeting becomes the only thing it ever says unprompted. 0 = play the goodbye (default). WHY YOU'D WANT IT: a hallway greeter is walked PAST far more often than it is talked to, so that window usually expires with nobody there and the clip is a farewell to an empty corridor. It is also BLOCKING -- it holds the audio lock until it finishes, which is time the next arrival cannot be greeted in. The face still changes to 'sleeping', so you can SEE it happen without hearing it, and the log says "sleeping SILENTLY".
ROBOT_CONCIERGE_SUMMARY_S=3600 # log ONE summary line every N seconds: PIR wakes, how many died in the cheap probe, how many became a greeting. Silent looks are DEBUG now (they were 3,741 INFO lines a day and buried everything that mattered), so this line is what tells you whether the sensor or the recogniser is the problem next time. 0 = off.
ROBOT_PIR_CHATTER_N=20       # PIR HEALTH WARNING: if more than this many motion wakes are accepted inside ROBOT_PIR_CHATTER_WINDOW_S, log a loud WARNING naming the usual causes (noisy 5V rail, sensor aimed at the Pi's fan exhaust / a heat source / a sunlit window, sensitivity pot too high). Purely diagnostic -- it never suppresses a wake, it just makes a misbehaving sensor impossible to miss in the log. 0 = never warn.
ROBOT_PIR_CHATTER_WINDOW_S=600 # the window for the chatter warning above, in seconds (default 10 minutes).
# -- WIRELESS second wake sensor (Zigbee, via Zigbee2MQTT over MQTT) -- OFF by default, ADDITIVE ---------
ROBOT_ZIGBEE_WAKE=0          # 1 = ALSO wake on a Zigbee occupancy sensor, OR'd with the wired PIR above -- whichever fires FIRST wakes the robot, and a second hit from the other sensor inside ROBOT_WAKE_DEDUPE_S is treated as the same person, not a new arrival. ADDITIVE, not a replacement: the wired PIR keeps behaving exactly as it does today, and every combination works (wired only / both / wireless only with ROBOT_PIR_PIN empty). Every part degrades independently -- no dongle, no broker, no paho-mqtt or a flat sensor battery all leave the wired PIR and the wake word untouched. Set up with ./scripts/patches/common/6_wake_zigbee_pir.sh; needs Zigbee2MQTT + an MQTT broker on the Pi. WHAT IT BUYS: coverage, NOT speed. GPIO interrupts in microseconds; a Zigbee event takes 50-300ms through the coordinator, Zigbee2MQTT and the broker, so for the SAME person the wired sensor wins nearly every race. Mount the wireless one where the wired one CANNOT see -- round a corner, the far end of a hall -- or it adds latency and nothing else.
ROBOT_ZIGBEE_TOPIC=          # the Zigbee2MQTT topic for your sensor, e.g. zigbee2mqtt/pir_hallway. EMPTY = the wireless source stays inert even when ROBOT_ZIGBEE_WAKE=1 (deliberately silent, since that is the normal state of every build without a dongle). Rename the device in the Z2M frontend FIRST so this is a readable name and not a MAC address. The code wakes on the RISING edge of `occupancy` (or `occupancy_state`) only -- Z2M also publishes the falling edge when the sensor's own occupancy_timeout expires, 60-90s AFTER the person left, and treating that as a trigger would wake the camera at an empty hallway every single time.
ROBOT_MQTT_HOST=localhost    # MQTT broker. Keep it on localhost: broker, Zigbee2MQTT and the brain all run on this Pi, so there is no reason to expose an unauthenticated broker to the LAN. If you ever move one off-box, add credentials in the SAME change.
ROBOT_MQTT_PORT=1883
ROBOT_MQTT_USER=             # empty = anonymous, which is correct for a 127.0.0.1-only listener
ROBOT_MQTT_PASS=
ROBOT_ZIGBEE_COOLDOWN_S=2    # per-source edge debounce for the wireless sensor, mirroring ROBOT_PIR_COOLDOWN_S: one burst of Zigbee reports = one wake.
ROBOT_ZIGBEE_OCCUPANCY_TIMEOUT_S=90 # YOUR SENSOR'S OWN occupancy_timeout, as set in the Zigbee2MQTT frontend (not a robot setting -- a copy of the device's). It exists because Z2M publishes occupancy:false when THAT timer expires, i.e. 60-90s after the person actually walked away. Taking the clear at face value would date the departure a minute late, and the departure-aware cooldown would then treat the NEXT arrival as the same person for that whole minute. The code subtracts this to put the departure back where it really was, so an over-estimate is safer than an under-estimate. Only used when ROBOT_ZIGBEE_WAKE=1.
ROBOT_WAKE_DEDUPE_S=2        # THE OR WINDOW. A second source firing within this long is the same person seen twice, not a new arrival, so it collapses into the existing wake. Deliberately SHORT: the real rate limiter is ROBOT_CONCIERGE_SILENT_COOLDOWN_S, which is armed AFTER the camera has looked and so decides with evidence, whereas a long blind window here would also delay a genuine second visitor. Raise to 5 only if both sensors cover the same doorway and you still see double greetings.
ROBOT_CONCIERGE_RECOGNIZE_S=7 # STAGE B -- once Stage A has seen somebody, keep SMILING and RETRYING face recognition for this many seconds before greeting (so one bad frame -- pose/blur/lighting -- isn't a missed greeting or a quick "flash"). Recognised -> greet by name; a face was seen but not matched -> a generic name-less greeting (then chat); lost them again -> silent, back to sleep (a cat/curtain/passer-by isn't greeted). Raised 5 -> 7: a visitor walking up needs a beat to face the camera, and this window now runs ONLY for frames that already had a person in them, so the extra seconds cost nothing in an empty room. 0 = single shot (old one-frame behavior).
ROBOT_CONCIERGE_RECOGNIZE_INTERVAL_S=0.2 # pause BETWEEN capture attempts inside that window. Unpaced, the loop ran the camera flat out (~20 stills/second = ~100 near-identical frames per wake). 0.25 -> 0.2 gives ~35 independent looks per visitor instead of ~15, affordable now that each frame runs the detector ONCE rather than twice. Consecutive stills milliseconds apart are the same image, so recall is unaffected. 0 = flat out (the old behaviour).
ROBOT_CONCIERGE_FACE_HITS=2   # GHOST-GREETING GUARD: how many frames in the window must show a face before Jarvis accepts "someone IS here" and gives the generic greeting. The Haar detector false-positives on scenery (a wall texture, a picture frame, a curtain fold), and with a 1-frame gate a single fluke anywhere in the burst was enough to greet an EMPTY room. A recognised MATCH is authoritative and still greets on its first frame -- this only gates the un-recognised path. 1 = the old one-frame behaviour.
ROBOT_FACE_ID_MODEL=         # path to the ArcFace recognition ONNX. empty = ~/.localairobot/models/arcface.onnx, downloaded by install_stack_pi5.sh/_jetson.sh (scripts/provision_face_id.sh). Missing -> face match OFF (concierge just smiles at everyone).
ROBOT_FACE_ID_THRESHOLD=0.38 # cosine-similarity match threshold (0..1). HIGHER = stricter (fewer false greetings, more misses); LOWER = looser. Tune per your enrolments + lighting.
ROBOT_FACE_ID_INPUT=112      # face model input size (px square). 112 for the standard ArcFace/buffalo recogniser; change only if your ONNX expects otherwise.
ROBOT_FACE_ID_DETECTOR=      # optional path to a Haar cascade XML, used ONLY on the Haar fallback path below. empty = OpenCV's bundled haarcascade_frontalface_default.xml.
ROBOT_FACE_ID_DETECTOR_BACKEND=auto # WHICH FACE DETECTOR -- and this is the single most important accuracy key in this file. auto (default) = YuNet if its model is present, else Haar. yunet = insist on YuNet (still falls back with a WARNING rather than leaving the concierge blind). haar = force the old detector. WHY IT MATTERS: ArcFace (the recogniser) is trained on 112x112 crops affine-warped so 5 landmarks land on fixed pixels. YuNet returns those landmarks so brain/face_id.py can align the crop; Haar returns only a box, so the crop CANNOT be aligned, ArcFace sees out-of-distribution input, and every similarity score collapses toward the same small number. A 19-hour field run on Haar recognised 6 of 257 face frames (2.3%) with scores squashed into 0.13-0.21 and the "closest" name spread evenly over all 35 enrolled people -- a lottery. Measured on this repo's own enrolment photos, alignment moves same-vs-different-person separation 0.334 -> 0.491, by-name recognition 75% -> 88%, and impostors above threshold 0.76% -> 0.12%. The startup line says which backend + whether alignment is live: journalctl -u robot.service | grep 'face_id:'
ROBOT_FACE_ID_YUNET_MODEL=   # path to the YuNet detection ONNX (~230KB). empty = ~/.localairobot/models/face_detection_yunet.onnx, downloaded by scripts/provision_face_id.sh. *** AFTER INSTALLING IT FOR THE FIRST TIME, RE-ENROL EVERYONE: bash enroll_all.sh *** -- stored embeddings are made by the same code path, so ones created before alignment are UNALIGNED, and aligning only the live side compares apples to noise (worse than not aligning at all).
ROBOT_FACE_ID_YUNET_SCORE=0.6 # YuNet detection confidence, 0..1. RAISE it (0.7-0.9) if scenery registers as a face; LOWER it (0.4-0.5) to notice people in poor light or steep profile, at the cost of more false detections (which ROBOT_CONCIERGE_FACE_HITS then has to filter). Ignored on the Haar path.
ROBOT_FACE_ID_MIN_MARGIN=0.08 # WRONG-NAME GUARD: how far clear of the RUNNER-UP the best match must be before Jarvis says a NAME out loud. Passing ROBOT_FACE_ID_THRESHOLD says "this looks like an enrolled person"; the margin says "and it is clearly THIS one" -- with 35 people enrolled those are different questions. A photo finish falls through to the friendly name-less greeting instead of guessing, because being called someone else's name is a worse failure than being greeted without one. The log prints every margin, so tune it from a real run. 0 = threshold only (the old behaviour).
ROBOT_FACE_ID_AGGREGATE=     # how to combine a person's MULTIPLE enrolled photos when matching (only matters for people enrolled with 2+ images). empty/max = best-matching photo wins (default; best recall, tolerant of pose/lighting). topk = mean of their top ROBOT_FACE_ID_TOPK photos (robust middle ground -- fewer false greetings than max). mean = average over ALL their photos (strictest). centroid = match against their averaged 'prototype' embedding (smooths per-photo noise). Enrol several photos per person: ./scripts/enroll_person.sh (files and/or --camera); see who's enrolled with ./scripts/rag.sh --faces.
ROBOT_FACE_ID_TOPK=3         # for ROBOT_FACE_ID_AGGREGATE=topk: how many of the person's best-matching photos to average. Ignored by the other strategies.
ROBOT_FACE_ID_MIN_NEIGHBORS=5 # HAAR-ONLY strictness (YuNet uses ROBOT_FACE_ID_YUNET_SCORE instead): how many overlapping detections a box needs before it counts as a face. RAISE it (6..8) when scenery keeps registering as a face (the log shows "no match ... face box NNpx" for a room with nobody in it); LOWER it (3..4) if real visitors go undetected in poor light. Applies to BOTH the presence check and the recognition crop.
ROBOT_FACE_ID_MIN_FACE_PX=60 # smallest face box (px) accepted from a LIVE camera frame, in a ROBOT_CAMERA_SIZE-px-square frame (default 512). Raise it to ignore faces too far away to recognise anyway -- and to reject small spurious boxes in textured scenery; lower it to greet people from further off (at the cost of more false detections and weaker matches).
ROBOT_FACE_ID_MIN_FACE_PX_ENROLL=40 # the same floor for ENROLMENT PHOTOS, deliberately lower. The live floor exists to discard distant passers-by in decisions made 20x a second with nobody watching; an enrolment is the opposite -- a human deliberately chose that photo, once, offline. Judging it by the live floor silently drops people (two of this repo's 73 enrolment photos have ~53px faces and were being discarded without a word). enroll() now logs when it accepts a face below the LIVE floor, since that person will be harder to recognise from across a room.
ROBOT_FACE_ID_WARMUP=1       # load the face model at STARTUP (in the background) instead of lazily on the first motion wake. That first lazy load happens INSIDE a visitor's recognition window and used to eat most of the 5s available to recognise them, so the FIRST person of every run was the most likely to get a silent smile. 0 = load on first use.

# --- DETECT CAPTURES: keep the frame behind each greeting, so you can see what Jarvis SAW ---
# On every motion wake Jarvis grabs a burst of stills. The frame that DECIDED the outcome is written here, so a
# ghost greeting or a missed friend is something you can LOOK at instead of guess about. The filename says which:
#   20260730-074742-known-ramesh.jpg   recognised -> greeted by name (this is the matching frame)
#   20260730-074743-unknown.jpg        a face was seen but not matched -> generic greeting
#   20260730-013120-noface.jpg         motion but no face -> stayed silent  (only kept when MODE=all)
# Retention is belt-and-braces so a 24/7 greeter can't fill the NVMe: a CRON JOB purges by age daily
# (scripts/purge_detect_captures.sh, installed by run_me.sh --install-boot and both install_stack_*.sh via
# scripts/install_detect_capture_cron.sh), and the brain ALSO self-prunes at startup against the same limits --
# so a robot whose cron never got installed still stays bounded.
ROBOT_DETECT_CAPTURE=1       # 1 = keep the deciding frame of each motion wake (default). 0 = keep nothing (also stops the cron purge being installed).
ROBOT_DETECT_CAPTURE_DIR=~/detect-captures # where they go. Must be a DEDICATED folder -- the purge script refuses to run against $HOME or / so a typo here can't become scheduled data loss.
ROBOT_DETECT_CAPTURE_MODE=greeted # greeted = only frames that produced a GREETING (recognised or generic) -- the useful ones, a handful a day. all = ALSO keep every silent look ("motion but no face"), which is the overwhelming majority of frames: turn this on for a session when you're chasing false PIR triggers, then turn it back off.
ROBOT_DETECT_CAPTURE_KEEP_DAYS=7 # delete captures older than this many days (cron + the brain's own startup prune). 0 = no age limit (then only the size cap applies).
ROBOT_DETECT_CAPTURE_MAX_MB=2000 # hard size cap: after the age pass, delete OLDEST-first until the folder is under this. Catches the case where a chattery sensor out-captures a DAILY purge. 0 = no cap.
ROBOT_DETECT_CAPTURE_CRON=1   # 1 = install the daily purge cron entry during --install-boot / install_stack_*.sh (default). 0 = don't touch the crontab (then purge by hand, or rely on the brain's startup prune). Remove it later: ./scripts/install_detect_capture_cron.sh --remove
ROBOT_DETECT_CAPTURE_CRON_SCHEDULE= # optional 5-field cron schedule for that purge. empty = "17 4 * * *" (04:17 daily -- off the hour, in the small hours).


# ==========================================================================
#   SOCIAL MEMORY  --  greetings that know they have met you before
#   Turns "who is this" into "who is this, when did I last see them, and what did they tell me". Seeing
#   someone at 8am and again at 4pm gives "nice to see you again -- how's your day been?" instead of a
#   context-free random pick; someone who mentioned school in the morning gets asked how it went; a job
#   learned in an earlier chat composes with the forecast ("I remember you're driving -- I hope the roads
#   aren't too hard in this rain"). It keeps learning the longer it runs.
#   NO LLM ON THE GREET PATH -- greetings stay a dict lookup, an indexed SELECT and a random.choice. The
#   one model call is the post-conversation extractor, on a daemon thread after everyone has stopped
#   talking. Two new tables (sightings, person_notes), both capped; the RAG's facts table is untouched.
#   ON BY DEFAULT. Full flow, and how to inspect or delete what it has learned: docs/social.md.
# ==========================================================================
ROBOT_SOCIAL_MEMORY=1        # 1 = Social Memory ON (default): sighting-aware greetings, the who-am-I-talking-to note in every conversation turn, and post-conversation learning. 0 = every greeting and every prompt is byte-for-byte what it was before this feature existed -- the tables stay, nothing reads or writes them. TWO THINGS TO KNOW BEFORE LEAVING IT ON: (1) a conversation where the person actually said something (2+ turns -- a greeting plus 'hello' is skipped) costs ONE extra model call at the end, routed exactly like conversation is: gemini/mixed WITH a ROBOT_GEMINI_API_KEY go remote and are billable, no key or 'local' stays on the local model; (2) it stores short notes about what people tell you (their job, today's plans) in the local RAG db -- nothing leaves the robot except that one extraction prompt, and docs/social.md shows how to read or delete any of it.
ROBOT_SOCIAL_LONG_GAP_D=14   # days after which a returning visitor gets the "it's been a while!" opener instead of the ordinary "good to see you again". Lower it for a household where everyone is seen daily; raise it if the robot sounds surprised by people who are simply away for a fortnight.
ROBOT_SOCIAL_PLAN_MIN_AGE_S=7200 # how long a stated plan must have been sitting before Jarvis asks how it went (default 2h). Someone who said "I'm off to school" ninety seconds ago has not been yet, and asking makes the robot feel broken rather than attentive. Plans expire at MIDNIGHT in ROBOT_WEATHER_TZ regardless, so nothing lingers to next week.
ROBOT_SOCIAL_CURIOSITY=1     # 1 = after a few exchanges with someone whose job it doesn't know, Jarvis asks -- in the model's own words, folded into the conversation, not as a canned interjection. The answer is picked up by the extractor. Kept as its own key because it is the one part of this feature that makes the robot INITIATE rather than respond: if anything here ever feels intrusive it will be this, and it should be switchable without giving up the memory itself.
ROBOT_SOCIAL_CURIOSITY_AFTER=3 # exchanges to wait before that nudge. 1 would make it an interview.
ROBOT_SOCIAL_CURIOSITY_COOLDOWN_D=30 # days before asking an unanswered question again. The marker is written whether or not they answer, so a reluctant visitor is asked monthly at worst rather than every single chat.
ROBOT_SOCIAL_EXTRACT_TIMEOUT_S=25 # per-attempt cap (seconds) on the post-conversation learning call. Much smaller than ROBOT_LLM_TIMEOUT_S on purpose: the extractor is background enrichment but it holds the SAME model lock a live turn needs, so at the full LLM budget a slow model could pin it for minutes while a visitor who just started talking gets nothing but the thinking earcon. Learning is never worth that -- abandoning one chat's notes costs far less. Blank = 25; floored at 5, and never allowed above ROBOT_LLM_TIMEOUT_S.
ROBOT_MEMORY_RETAIN_SIGHTINGS=2000 # how many sighting rows to keep (count-based, swept by the existing prune pass). 2000 is months of a busy hallway; the greeting only ever reads the newest one per person.
ROBOT_MEMORY_RETAIN_NOTES=50 # stable notes kept PER PERSON (jobs, likes). Per-person, not global, so one chatty visitor cannot evict everyone else's. Expired plans are deleted outright rather than counted.


# ==========================================================================
#   WEATHER  --  3-day forecast card on the sleep screen + weather-aware greetings
#   The ONE online feature in an otherwise offline robot, so it is strictly ADDITIVE: no network just means
#   the cached forecast, then time-of-day greetings and the normal Zzz sleep face. Nothing in the greeting
#   path, the command loop or startup ever waits on a fetch -- a daemon thread polls, everything else reads
#   the last snapshot. Three surfaces: the forecast CARD replaces the sleeping face; greetings gain a
#   weather sentence; "what's the weather" is answered from data instead of hallucinated. Full setup +
#   what degrades when the internet is down: docs/weather.md.
#   ON BY DEFAULT, pointed at the Melbourne city centre -- see the LAT/LON note below for why that is a
#   landmark and not anybody's house, and for how to point it at yours.
# ==========================================================================
ROBOT_WEATHER_ENABLE=1       # 1 = weather ON (default): forecast card on the sleep screen + weather-aware greetings + the spoken forecast. 0 = the feature is inert -- no thread, no network, no new log lines, and every face/greeting/command path behaves exactly as it did before weather existed. Being on costs one daemon thread and 48 HTTP requests a day; with no internet it simply degrades (cached -> stale -> plain time-of-day greetings and the normal Zzz face), so there is no reason to ship it off.
ROBOT_WEATHER_PROVIDER=open-meteo # WHERE the forecast comes from. open-meteo is the only provider that ships (keyless, no account, no rate-limit key -- one robot polling every 30 min uses 48 of its ~10k/day fair-use budget). The key exists as the hot-swap point: a new source is one class with a fetch() that returns the same normalized days, plus one registry entry in brain/weather.py -- nothing outside that class ever sees a provider's own condition codes. An unrecognised value logs a warning naming the known providers and leaves weather unavailable (it never raises).
ROBOT_WEATHER_LAT=-37.81     # Latitude. *** THIS IS THE MELBOURNE CITY CENTRE, DELIBERATELY -- a landmark, not a home address. *** The feature is on by default and a blank coordinate would leave it merely "enabled" while doing nothing, so the template ships a working public location instead. PRIVACY: this file is TRACKED BY GIT, and a real house coordinate here would publish where you live. Put YOUR numbers in your LOCAL-ONLY commit alongside the API key, never in the template. Get them from any map: right-click your house -> the two numbers are lat, lon. Blank = weather stays off with one explanatory line in the log.
ROBOT_WEATHER_LON=144.96     # ...and longitude, same rules. 2 decimals (~1km) is plenty -- a forecast grid cell is coarser than that, so extra precision only leaks. Worth overriding for a suburb well away from the CBD: temperature and especially RAIN can genuinely differ across a metro area, and the greeting tells people whether to take an umbrella.
ROBOT_WEATHER_TZ=            # IANA timezone, e.g. Australia/Melbourne (the default when blank). Used for TWO things: the API sends day boundaries in this zone, and the greeting decides morning/afternoon/evening by it. It is an explicit key rather than "just use the system clock" because NOTHING in this repo sets the Pi's timezone -- a freshly-imaged SD card is often UTC, which in Melbourne means the robot says "good evening" at breakfast. An invalid zone warns ONCE and falls back to the system clock.
ROBOT_WEATHER_REFRESH_S=1800 # how often to re-fetch the forecast (seconds). 1800 = every 30 min, which is well inside a daily forecast's useful life and trivial against the provider's budget. 0 = fetch ONCE at startup and never again -- note the poll thread still ticks hourly even then, because the card has to roll "Today" over at MIDNIGHT without a network call. Raise it on a metered/flaky link; there is no reason to go below ~600.
ROBOT_WEATHER_TIMEOUT_S=8    # total network budget for ONE fetch attempt cycle (seconds), split across retries against an absolute deadline -- the same shape inference.py uses for Ollama. A weather fetch NEVER blocks a greeting, a command or startup (it only ever runs on the poll thread), so this bounds the thread, not the robot.
ROBOT_WEATHER_STALE_S=21600  # HOW LONG A CACHED FORECAST STAYS USABLE after the fetch that produced it (21600 = 6h). Inside this window an offline robot keeps showing and speaking the last-good forecast; past it the data is dropped -- get() returns nothing, the card reverts to the honest Zzz sleep face, and greetings go back to time-of-day. The point is to be OFFLINE-TOLERANT WITHOUT LYING: a 6-hour-old forecast is still broadly true, a two-day-old one is fiction told with confidence.
ROBOT_WEATHER_CACHE=         # where the last-good forecast is written so a reboot during an internet outage still has one. Blank = ~/.localairobot/weather_cache.json (the same state home as the RAG db and the face models). A disk error here is not fatal: it logs one warning and runs from memory only.
ROBOT_WEATHER_GREETING=1     # 1 = concierge greetings become time- and weather-aware: a "Good morning, [Name]!" opener plus ONE advice sentence chosen from today's forecast ("...it's a very chilly day, pack your jumper" / umbrella / sunscreen / storms). 0 = the plain concierge greeting, byte-for-byte unchanged. With no usable forecast the advice sentence is simply omitted -- the greeting never waits, never pads awkwardly and never breaks. Halloween Mode outranks this: on Halloween the spooky greeting wins and no weather line is added.
ROBOT_WEATHER_CHILLY_C=15    # today's MAX at or below this (deg C) -> the "pack a jumper" advice. Max, not the current temperature, because the question a greeting answers is "how should I dress for today".
ROBOT_WEATHER_HOT_C=30       # today's MAX at or above this (deg C) -> the sunscreen/water advice. Between the two bands it is a pleasant-day line. Rain and storms outrank BOTH temperature bands -- being wet beats being warm.
ROBOT_WEATHER_TRIGGERS=      # EXTRA comma-separated phrases that make a question a weather question ("what's it doing outside,brolly weather"). These ADD to the built-in list (unlike ROBOT_LOOK_TRIGGERS, which replaces it) so adding one phrase cannot silently cost you the other thirteen. Matching is plain substring on the raw transcript, so keep entries MULTI-WORD: a bare "temperature" would hijack "what's your CPU temperature".


# ==========================================================================
#   DRIVE  --  PCA9685 PWM, throttle (ESC), steering, reverse
#   PWM generated by a PCA9685 over I2C 0x40. Calibrate on the bench.
# ==========================================================================
# -- PCA9685 channels (which output the ESC and steering servo are wired to) --
ROBOT_PCA9685_CHANNELS=16
ROBOT_ESC_CHANNEL=0
ROBOT_STEER_CHANNEL=1
# -- Steering servo (degrees). Calibrate CENTER so the wheels point dead ahead, then nudge LEFT/RIGHT until
#    the wheels turn fully WITHOUT the linkage binding/buzzing. --
ROBOT_STEER_CENTER=95
ROBOT_STEER_LEFT=135
ROBOT_STEER_RIGHT=30
# -- Throttle (ESC) CALIBRATION -- LEFT BLANK ON PURPOSE. These are per-ESC-model, so they live in your ESC
#    PATCH, not here -- run ONE:  scripts/patches/common/1_esc_hb_qr_1060.sh  OR  1_esc_uliik_60a.sh  (the
#    only two supported ESCs). Blank so config never carries a calibration that fights the patch (empty ->
#    the code's generic default until a patch runs). To hand-tune: bench-sweep (see BENCH_SCRIPTS.md), then
#    put the values in the PATCH. Speed 1..100 maps MIN..MAX, the ACTUAL SIGNED throttle written (1500us=0.0,
#    2000us=+1.0, 1000us=-1.0): FORWARD sits ABOVE neutral, REVERSE BELOW it. MIN = where it JUST crawls,
#    MAX = top speed. Reverse's MAX is deeper below neutral (more negative) than its MIN. --
ROBOT_MIN_FORWARD_SPEED=     # FORWARD slowest crawl  (set by the ESC patch; e.g. 1060 = 0.55)
ROBOT_MAX_FORWARD_SPEED=     # FORWARD top speed       (1060 = 0.95)
ROBOT_MIN_REVERSE_SPEED=     # REVERSE slowest crawl -- signed, below neutral (1060 = 0.00)
ROBOT_MAX_REVERSE_SPEED=     # REVERSE top speed -- deeper below neutral, more negative = faster (1060 = -0.20)
ROBOT_ESC_NEUTRAL=           # rest/STOP + ARM throttle; per-ESC OFFSET (1060 = 0.25, ULIIK = 0.40). empty -> code default 0.0 (1500us). Holding it arms the ESC (wait for the long beep)
ROBOT_THROTTLE_INVERT=       # 1 if FORWARD/REVERSE come out swapped (set by the patch; usually 0 -- or just swap the 2 motor wires)
ROBOT_ESC_REVERSE_DOUBLETAP= # F/R DIRECT reverse (0) vs old F/B/R "double-click" (1); set by the patch. Both supported ESCs are F/R -> 0
# -- Throttle granularity (NOT per-ESC-model; safe to keep here) --
ROBOT_SPEED_INCREMENT_STEP=0.05   # quantize the mapped throttle to steps of this size (measured from MIN) so speed changes in clean increments. 0 / empty = OFF (smooth, continuous)
# -- General drive behaviour (NOT per-ESC-model) --
ROBOT_DRIVE_CRAWL_SPEED=5    # crawl-by-default: normal DRIVE commands ("come forward"/"follow me") are capped to this speed (near MIN). Only saying fast/quick/hurry lets speed climb to 100.
ROBOT_ESC_ARM_SECS=3         # how long the brain holds neutral at startup so the ESC arms. Have the ESC powered ON while it holds neutral (ROBOT_ESC_NEUTRAL); wait for the long beep.
ROBOT_ESC_ARM_PROMPT=1       # 1 = at startup (after "systems online") SPEAK "switch the speed controller on now" -- the headless cue for the CORRECT power order (Pi up + holding neutral FIRST, THEN switch the ESC on so it arms to neutral; ESC-first mis-arms -> forward/neutral can drive REVERSE). 0 = silent. Only spoken live + motors-on + crawler mode.
ROBOT_ESC_REV_BRAKE_MS=400   # (F/B/R ESCs only; unused when DOUBLETAP=0) tap1 length the ESC reads as a brake
ROBOT_ESC_REV_GAP_MS=300     # (F/B/R ESCs only; unused when DOUBLETAP=0) neutral gap between the two taps
# -- Software failsafe: hard cap on how long one command may keep the motor running --
ROBOT_MAX_MOVE_MS=5000


# ==========================================================================
#   OBSTACLE SENSORS  --  3x HC-SR04P (semi-hex array), all 3.3V, ECHO Pi-safe
#   Software-timed on the Pi 5 (no pigpio) -- see the quiesce/max-distance
#   notes below, which are what keep the sensors from starving the wake mic.
# ==========================================================================
# -- Forward gate --
ROBOT_OBSTACLE_CM=8          # forward STOP distance (cm): cut FORWARD when the FRONT beam is closer than this. Low = it gets very close before stopping (little reaction margin; mind the front-beam blind spot). NOTE: a FAILED front read (-1.0 sentinel) also trips the gate regardless of this value.
ROBOT_OBSTACLE_DEBOUNCE=3    # consecutive close/failed front reads before a move ABORTS. gpiozero's software-timed echo jitters an odd garbage frame (even negative cm) under load; 1 = old trigger-happy behaviour. Each frame still holds neutral, so it never drives while unsure.
ROBOT_SENSOR_MAX_DISTANCE_M=1.0  # HC-SR04P echo range cap (m). A NO-ECHO ping busy-waits the full timeout (proportional to this). 1.0 (was 2.0) halves that wait; the gate only needs <30cm. Raise only if explore must sense further.
ROBOT_SENSOR_IDLE_QUIESCE=1      # 1 (default): CLOSE the 3 sensors while idle-listening for the wake word so their software-timed threads stop starving the mic; rebuilt for each drive/explore. 0 = keep them always on. Auto-off under --verbose.
ROBOT_SENSOR_VERBOSE=0           # 1 (or run_me.sh --verbose): stream a live 'SENSORS front/left/right' read-out every ROBOT_SENSOR_LOG_PERIOD_S s + show every no-echo. Adds a little load -- a diagnosis switch, not for 'forever'. Also disables idle-quiescing so you can watch the sensors.
ROBOT_SENSOR_LOG_PERIOD_S=2.0    # how often the --verbose SENSORS read-out prints (seconds).
# -- Distance-sensor BACKEND: hcsr04 (default -- 3x ultrasonic on the TRIG/ECHO pins below) OR vl53l1x (3x
#    I2C laser ToF: ~50 Hz, 400 cm, no TRIG/ECHO -- they share the PCA9685 I2C bus). Switch to ToF with:
#      sed -i 's/^ROBOT_SENSOR_TYPE=.*/ROBOT_SENSOR_TYPE=vl53l1x/' config/robot.env
ROBOT_SENSOR_TYPE=hcsr04
# -- HC-SR04 timing backend (Pi 5 only; ignored for vl53l1x and on the Jetson). rawping (default) = a raw
#    TRIG/ECHO ping timed in a tight thread (brain/hcsr04_pi5.py) -- the SAME method as
#    scripts/ultrasonic_sensor_probe.sh, which reads reliably where gpiozero's software-timed DistanceSensor
#    WEDGES under CPU load (the front beam sticking at 0cm/no-echo -> forward gate falsely blocked). It also
#    fires the 3 beams one-at-a-time to stop cross-talk. gpiozero = the old DistanceSensor (fall back only if
#    rawping misbehaves).
ROBOT_HCSR04_BACKEND=rawping
# -- VL53L1X ToF keys (used ONLY when ROBOT_SENSOR_TYPE=vl53l1x; ignored for hcsr04, and the six TRIG/ECHO
#    pins below are then unused). All three units boot at 0x29, so each gets its own XSHUT pin (board pin
#    scheme: Pi=BCM, Jetson=BOARD header) and a distinct address assigned at startup -- set the XSHUT pins to
#    YOUR wiring. After boot, `i2cdetect` should show 0x29/0x2A/0x2B. (~50 Hz/beam: you may drop
#    ROBOT_OBSTACLE_DEBOUNCE from 3 to 2 for a snappier gate; leave it if unsure.)
ROBOT_TOF_XSHUT_FRONT=17   # front sensor XSHUT pin  (example: Pi BCM 17)
ROBOT_TOF_XSHUT_LEFT=27    # left  sensor XSHUT pin  (example: Pi BCM 27)
ROBOT_TOF_XSHUT_RIGHT=22   # right sensor XSHUT pin  (example: Pi BCM 22)
ROBOT_TOF_ADDR_FRONT=0x2A  # assigned I2C address (front)
ROBOT_TOF_ADDR_LEFT=0x2B   # assigned I2C address (left)
ROBOT_TOF_ADDR_RIGHT=0x29  # assigned I2C address (right; the power-on default)
# -- OPTIONAL add-on sensors (NEW capabilities; DISABLED by default -- empty = the robot behaves EXACTLY as
#    before). These land only the reader + config seam; wiring them into closed-loop turns / odometry is
#    future work. Enable: ./scripts/patches/common/4_imu_bno085.sh or common/4_encoder_as5600.sh (each also
#    installs its pip lib). See brain/imu.py / brain/encoder.py.
ROBOT_IMU_TYPE=            # empty = no IMU | bno085 = BNO085/BNO08x 9-DOF heading + yaw over I2C
ROBOT_IMU_ADDR=0x4A        # BNO085 I2C address (0x4A default; 0x4B if the SA0 pin is high)
ROBOT_ENCODER_TYPE=        # empty = no encoder | as5600 = AS5600 12-bit magnetic angle sensor over I2C
ROBOT_ENCODER_ADDR=0x36    # AS5600 I2C address (0x36 -- NB: clashes with the UPS-HAT fuel gauge; use a separate bus if you fit both)
# These six pins are Pi BCM GPIO numbers (this is the Pi profile). On a JETSON they are the WRONG numbering:
# COMMENT THEM OUT and set the Jetson header pins in the BOARD SELECT section near the top (or let the jetson
# board default them). If left as Pi pins while ROBOT_BOARD resolves to a BOARD-numbered board, the brain
# logs a "SENSOR PINS are the Raspberry Pi BCM defaults" WARNING at startup so the mistake is never silent.
ROBOT_TRIG_PIN=23            # front TRIG, BCM GPIO number
ROBOT_ECHO_PIN=24            # front ECHO, BCM GPIO number (HC-SR04P ECHO is 3.3V; a bare HC-SR04 needs a divider)
# -- Side sensors (left/right beams; explore steering-avoid) --
ROBOT_LEFT_TRIG_PIN=5
ROBOT_LEFT_ECHO_PIN=6
ROBOT_RIGHT_TRIG_PIN=20
ROBOT_RIGHT_ECHO_PIN=21
ROBOT_SIDE_OBSTACLE_CM=25    # explore steering-avoid threshold for the left/right beams (biases steering; does NOT stop)
ROBOT_SIDE_CUT_CM=12         # side COLLISION cut (cm): the angled left/right beams see a diagonal obstacle the FRONT beam misses, so if EITHER side is within this the forward move is CUT too (the corner would otherwise clip it). Keep it TIGHT + below ROBOT_SIDE_OBSTACLE_CM (the sides normally see passing walls). Explore also backs-up + turns AWAY at this range. A failed side read (-1) = clear.
ROBOT_FAKE_LEFT_CM=200       # dry-run synthetic left distance
ROBOT_FAKE_RIGHT_CM=200      # dry-run synthetic right distance


# ==========================================================================
#   ENCLOSURE COOLING FAN  --  GPIO exhaust fan, temperature-controlled (brain/fan.py)
#   OPT-IN, OFF by default. For a robot sealed in a box: the active cooler just recirculates hot air, so a
#   GPIO-switched EXHAUST fan pushes it OUT. A background thread turns the fan ON when the SoC runs hot and
#   OFF once it cools (hysteresis stops chatter). Rising LOAD shows up as rising TEMP, so temp is the trigger.
#   WIRING: a 3.3V GPIO can't power a fan -- drive the fan through a logic-level N-MOSFET (GPIO -> gate, fan
#   between +V and drain, common ground). The pin is the board's scheme (Pi = BCM, Jetson = BOARD header).
# ==========================================================================
ROBOT_FAN_ENABLE=0           # 1 = run the enclosure exhaust fan; 0 = disabled (nothing changes; active cooler still works)
ROBOT_FAN_PIN=26             # GPIO pin driving the fan MOSFET (Pi BCM number / Jetson BOARD number). REQUIRED when enabled. Don't reuse a sensor/PWM pin. BCM26 (phys pin 37) = free in BOTH the HC-SR04 and VL53L1X builds; not the PIR (GPIO4), not a TRIG/ECHO/XSHUT pin.
ROBOT_FAN_ON_TEMP_C=70       # turn the fan ON at/above this SoC temperature (deg C)
ROBOT_FAN_OFF_TEMP_C=60      # turn it OFF at/below this (the gap ON..OFF is the hysteresis; keep OFF a few deg below ON)
ROBOT_FAN_POLL_S=5           # how often to check the temperature (seconds); min 1


# ==========================================================================
#   AUTONOMY  --  explore / find / look (only if a trigger phrase is spoken)
#   EXPLORE is AGENTIC: the model picks each next move + when it's done
#   (vision.explore_step), bounded by BACKEND-AWARE caps (2x on remote) and
#   stoppable via HTTP /stop, the wake word, or Ctrl-C.
# ==========================================================================
ROBOT_EXPLORE_TRIGGERS="explore,explore around,explore the,look around,look around the,have a look,take a look,find,look for,search for,where is,go to,go towards,go find,go explore,move towards,move toward,head towards,head to,drive to,drive towards,drive toward,approach,get to,come to,come towards,wander,roam,patrol,scout,check out,go and look"
ROBOT_LOOK_TRIGGERS="what is this,what's this,what is that,what's that,what do you see,what can you see,what are you looking at,what am i holding,look at this,look at that,what is in front,what's in front,describe what you see,can you see"   # a LIVE-view question -> capture a FRESH frame + describe (LOOK), not answer from memory
ROBOT_EXPLORE_MAX_ITERS=12           # LOCAL explore + FIND: max look->step iterations before giving up
ROBOT_EXPLORE_MAX_ITERS_REMOTE=24    # REMOTE explore: 2x (Gemini/any remote is faster + smarter)
ROBOT_EXPLORE_MAX_SECONDS=60         # LOCAL explore: wall-clock cap (whichever cap hits first ends it)
ROBOT_EXPLORE_MAX_SECONDS_REMOTE=120 # REMOTE explore: 2x
ROBOT_EXPLORE_NARRATE=1              # explore: speak what it notices each step (0 = silent, just store to memory)
ROBOT_EXPLORE_STEP_MS=1500   # forward step per move (explore + FIND toward a sighted target) -- longer = more ground covered per look
ROBOT_SCAN_STEP_MS=700       # FIND: arc-scan nudge when the target isn't framed yet
ROBOT_EXPLORE_SPEED=25       # throttle 0-100 used during explore/find (a slow-but-purposeful roam)
ROBOT_EXPLORE_MIN_ITERS=2    # explore: drive at least this many steps before honouring the VLM's "done" (a weak local VLM often calls done on frame 1 -> never moves)
ROBOT_EXPLORE_ESCAPE_CM=25   # explore: when the FRONT beam is within this, back up + turn toward the more-open side instead of pinning at the wall. Keep it ABOVE ROBOT_OBSTACLE_CM so it reacts before the hard gate.
ROBOT_EXPLORE_ESCAPE_SPEED=8 # explore: throttle 0-100 for the escape REVERSE + recovery turn. The rear is UNSENSED, so keep this a LOW crawl -- at crawl speed a longer reverse is still just a tap, never a dash into whatever is behind.
ROBOT_EXPLORE_ESCAPE_MS=1500 # explore: how long the BLIND escape REVERSE runs before it RE-CHECKS the sides + turns to the open one. Long enough to actually pull off the obstacle. Raise THIS (the safe lever), not the speed, if it still doesn't back up far enough.
ROBOT_EXPLORE_ESCAPE_MAX_TRIES=3 # explore: after this many CONSECUTIVE escapes fail to clear the front, STOP + say "I'm stuck" instead of grinding the whole run in a wedged corner (or on a power-starved false-low front sensor). The reverse lengthens on each repeat.
ROBOT_FIND_CONFIDENCE=0.55   # min vision confidence to act on a sighting
ROBOT_APPROACH_CM=40         # treat the target as reached when the forward beam is closer than this


# ==========================================================================
#   ENVIRONMENT MEMORY  --  SQLite RAG; survives reboots; summarised into the
#   prompt. Taught facts + explore scenes are RANKED for relevance to each
#   question (SQLite FTS5 / BM25), falling back to newest-first if there's no
#   match (or no FTS5 in this build). Inspect/search/clear with scripts/rag.sh
#   (try: rag.sh --search "the garage").
# ==========================================================================
ROBOT_MEMORY_DB=~/.localairobot/memory.db
ROBOT_MEMORY_MAX_CONTEXT=8   # recent distinct objects fed back to the model
ROBOT_MEMORY_MAX_SCENES=3    # scene DESCRIPTIONS (from agentic explore) fed back to the model / rag.sh --scenes (relevance-ranked)
ROBOT_MEMORY_RETAIN=5000     # max NON-scene observations kept (routine 'look' churn); older ones are pruned
ROBOT_MEMORY_RETAIN_SCENES=500  # scene rows kept SEPARATELY so routine looks never evict the costly explore summaries


# ==========================================================================
#   FACE SCREEN  --  USB-C serial panel (turing) OR a DSI/HDMI screen
#   (framebuffer), else procedural/simulated. Optional PNG animations too.
# ==========================================================================
ROBOT_FACE_ENABLE=1
ROBOT_FACE_BACKEND=auto      # auto | turing (USB-C serial) | framebuffer (DSI/HDMI -> /dev/fb0) | simulated. auto tries turing->framebuffer->simulated
ROBOT_FACE_PORT=AUTO         # turing only: serial port, or /dev/ttyACM0
ROBOT_FACE_REVISION=A        # turing only: A (Turing/UsbPCMonitor 320x480) | B (XuanFang) -- confirm via the lib's simple-program.py
ROBOT_FACE_WIDTH=320         # turing only: panel NATIVE geometry (portrait, W<=H). ROBOT_FACE_ORIENTATION rotates the face for a sideways mount. framebuffer auto-reads size+depth from the kernel (Freenove 800x480, 32bpp handled)
ROBOT_FACE_HEIGHT=480        # turing only (see above)
ROBOT_FACE_ORIENTATION=landscape  # turing only: rotate the face for how the panel is MOUNTED. landscape (wide, default) | portrait (native) | reverse_landscape (use if the face is upside-down) | reverse_portrait
ROBOT_FACE_PARTIAL=1         # turing only: 1 = push only the CHANGED region each frame (fast talking/animation on slow rev-A serial); 0 = always full frames (set if a panel mis-renders positioned sub-images)
ROBOT_FACE_MAX_FPS=          # turing only: cap the animation frame rate. empty = 10 (turing) / 30 (framebuffer). rev-A serial is slow; raise cautiously.
ROBOT_FACE_TALK_DELAY_MS=0   # ms to start the 'talking' mouth animation AFTER speech playback begins. 0 (default) = start with the audio (the mouth no longer moves during the slow Piper synthesis). Nudge up (e.g. 150) only if the DSI/HDMI face still visibly LEADS the first sound.
ROBOT_FACE_BRIGHTNESS=80
ROBOT_FACE_LIB=~/turing-smart-screen-python   # cloned by scripts/install_stack_pi5.sh
ROBOT_FACE_DUMP=             # optional dir to save rendered face PNGs (bench debugging)
# -- Animated faces (optional PNG sequences; brain/face.py). Frames in <ROBOT_FACE_FRAMES_DIR>/<state>/NN.png.
#    >=2 frames animate; 1 = static still; none = the built-in procedural face. --
ROBOT_FACE_FRAMES_DIR=              # default: brain/faces
ROBOT_FACE_FPS=4                    # default frame rate for looping states (talking runs faster; turing capped)


# ==========================================================================
#   PHONE COMMAND ENDPOINT (HTTP)  --  command the robot from your phone
#   A tiny token-secured HTTP server runs INSIDE the brain: POST a dictated
#   command to http://<hostname>.local:PORT/speak -> the SAME brain acts +
#   speaks + returns the reply as JSON. First run auto-generates the token.
#   Setup + security: docs/http_setup.md
# ==========================================================================
ROBOT_HTTP_ENABLE=1          # 0 = off. On by default; starts with every brain launch.
ROBOT_HTTP_PORT=8080         # http://<hostname>.local:PORT/speak
ROBOT_HTTP_TOKEN=            # shared secret the phone MUST send (X-Robot-Token header or ?token=). EMPTY -> auto-generated + saved here on first run.
ROBOT_HTTP_ALLOW_CAMERA=0    # 0 = block camera actions (look around / find / remember) over HTTP so a stolen token can't peek; 1 = allow them.
