# ---- Mode (bench dry-run) ----
# 1 = no PCA9685 / ESC (Electronic Speed Controller) / servo / sensors needed. driver.py swaps in fakes and logs every
# intended GPIO/PWM/I2C action to the console, so you can verify voice -> model -> hardware
# mapping on an unwired Pi (or a laptop) before building the chassis. ROBOT_SIMULATE is an alias.
ROBOT_DRY_RUN=0
ROBOT_FAKE_DISTANCE_CM=200   # dry-run synthetic forward distance; set <30 to make the gate trip

# ---- AI stack (replace YOUR_USER with your Linux username) ----
ROBOT_MODEL=gemma4:e2b-it-qat   # 4-bit QAT text/intent brain (fast on the Pi); vision is separate -> ROBOT_VISION_MODEL
ROBOT_OLLAMA_URL=http://localhost:11434/api/generate
ROBOT_LLM_TIMEOUT_S=120     # text-intent call timeout; raise if the first-command cold model load times out
ROBOT_WHISPER_BIN=/home/YOUR_USER/whisper.cpp/build/bin/whisper-cli
ROBOT_WHISPER_MODEL=/home/YOUR_USER/whisper.cpp/models/ggml-base.en.bin
ROBOT_PIPER_BIN=/home/YOUR_USER/piper/piper/piper
ROBOT_PIPER_VOICE=/home/YOUR_USER/piper/en_US-lessac-medium.onnx
ROBOT_MIC=plughw:2,0
ROBOT_RECORD_SECS=4
ROBOT_TMPDIR=/dev/shm

# ---- PCA9685 PWM channels (which output the ESC (Electronic Speed Controller) and steering servo are wired to) ----
ROBOT_PCA9685_CHANNELS=16
ROBOT_ESC_CHANNEL=0
ROBOT_STEER_CHANNEL=1

# ---- Steering servo (degrees). Calibrate CENTER so the wheels point dead ahead, then ----
# ---- nudge LEFT/RIGHT until the wheels turn fully WITHOUT the linkage binding/buzzing. ----
ROBOT_STEER_CENTER=90
ROBOT_STEER_LEFT=55
ROBOT_STEER_RIGHT=125

# ---- Throttle (ESC (Electronic Speed Controller)). Keep the cap low on a heavy crawler so the LLM lag isn't dangerous. ----
ROBOT_MAX_THROTTLE=0.35
ROBOT_THROTTLE_INVERT=0      # set to 1 if FORWARD/REVERSE come out swapped
ROBOT_ESC_ARM_SECS=3         # neutral hold at startup so the ESC (Electronic Speed Controller) arms (it will beep)

# ---- Forward obstacle gate (HC-SR04P on Pi GPIO; 3.3V, ECHO Pi-safe, no level shifter) ----
ROBOT_OBSTACLE_CM=30
ROBOT_TRIG_PIN=23            # BCM GPIO number
ROBOT_ECHO_PIN=24           # BCM GPIO number (HC-SR04P ECHO is 3.3V; a bare HC-SR04 needs a divider)

# ---- Side ultrasonic sensors (semi-hex array; all HC-SR04P at 3.3V, ECHO Pi-safe) ----
ROBOT_LEFT_TRIG_PIN=5
ROBOT_LEFT_ECHO_PIN=6
ROBOT_RIGHT_TRIG_PIN=20
ROBOT_RIGHT_ECHO_PIN=21
ROBOT_SIDE_OBSTACLE_CM=25    # explore steering-avoid threshold for the left/right beams
ROBOT_FAKE_LEFT_CM=200       # dry-run synthetic left distance
ROBOT_FAKE_RIGHT_CM=200      # dry-run synthetic right distance

# ---- Software failsafe: hard cap on how long one command may keep the motor running ----
ROBOT_MAX_MOVE_MS=5000

# ---- Camera (Pi Camera V2 NoIR via picamera2) + vision (dedicated moondream VLM, ROBOT_VISION_MODEL) ----
ROBOT_CAMERA_ENABLE=1
ROBOT_CAMERA_SIZE=512        # square letterbox target before base64 (keeps Gemma3 to one crop)
ROBOT_CAMERA_WARMUP_S=1.0    # let auto-exposure / white-balance settle before the capture
ROBOT_VISION_TIMEOUT_S=600   # Ollama image call is SLOW on the Pi 5 CPU (tens of s to minutes)
ROBOT_FAKE_VISION=           # dry-run scripted sighting "target:horizontal:distance:confidence" (e.g. sofa:left:near:0.9)

# ---- Face screen (3.5" USB-C panel; auto-falls back to DSI/HDMI framebuffer, else simulated) ----
ROBOT_FACE_ENABLE=1
ROBOT_FACE_BACKEND=auto      # auto | turing | framebuffer | simulated
ROBOT_FACE_PORT=AUTO         # or /dev/ttyACM0
ROBOT_FACE_REVISION=A        # A (Turing/UsbPCMonitor 320x480) | B (XuanFang) -- confirm via the lib's simple-program.py
ROBOT_FACE_WIDTH=320
ROBOT_FACE_HEIGHT=480
ROBOT_FACE_BRIGHTNESS=80
ROBOT_FACE_LIB=~/turing-smart-screen-python   # cloned by scripts/install_stack.sh
ROBOT_FACE_DUMP=             # optional dir to save rendered face PNGs (bench debugging)

# ---- Autonomy: explore / find behaviour (only runs if a trigger phrase is in the transcript) ----
ROBOT_EXPLORE_TRIGGERS="explore,look around,have a look,take a look,find,look for,search for,where is,go to,go towards,move towards,move toward,head towards"
ROBOT_EXPLORE_MAX_ITERS=6    # FIND: max look->step iterations before giving up
ROBOT_EXPLORE_STEP_MS=900    # FIND: forward step toward a sighted target
ROBOT_SCAN_STEP_MS=700       # arc-scan nudge when the target/scene isn't framed yet
ROBOT_EXPLORE_SPEED=30       # throttle 0-100 used during explore/find (kept low)
ROBOT_EXPLORE_SCANS=3        # EXPLORE ("look around"): how many arc-scan looks to take
ROBOT_FIND_CONFIDENCE=0.55   # min vision confidence to act on a sighting
ROBOT_APPROACH_CM=40         # treat the target as reached when the forward beam is closer than this

# ---- Environment memory (SQLite; survives reboots; summarised back into the prompt) ----
ROBOT_MEMORY_DB=~/.localairobot/memory.db
ROBOT_MEMORY_MAX_CONTEXT=8   # recent distinct objects fed back to the model

# ---- Model orchestration (warmup + keep-alive + shared model lock; see brain/inference.py) ----
# Text-intent and vision share ONE Ollama model server; a single in-process lock serialises them
# (so two generates never collide) and keep-alive stops Ollama evicting the model between commands.
ROBOT_WARMUP=1               # prime the model at boot so the FIRST command isn't a slow cold load
ROBOT_OLLAMA_KEEPALIVE=30m   # keep the model resident: '30m', '-1' = forever, '' = Ollama default (~5m)
ROBOT_NUM_CTX=4096           # cap Ollama's KV-cache context (Gemma 4 defaults to 128K -- way more than
                             # short commands need). Smaller = faster + less RAM on the Pi. 0 = Ollama default.

# ---- Dedicated vision model (decouples vision latency from the text brain) ----
# Vision runs on its OWN VLM, separate from ROBOT_MODEL. Default 'moondream' (pulled by
# install_stack.sh) -- small/fast, light on the 16GB Pi. KEEP THIS SET: empty falls back to sharing
# ROBOT_MODEL, which is slower (and only works at all if THAT model can see). moondream is the safe pick.
# To switch the VLM: `ollama pull <new>`, set it here, then re-source.
ROBOT_VISION_MODEL=moondream

# ---- Wake word (openWakeWord; ON by default -> always-listening) ----
# The robot listens continuously and wakes on the phrase set by ROBOT_WAKEWORD_MODEL (stock "hey
# jarvis" by default; a custom "hey richard" also ships in models/), then records a command like the
# ENTER flow. ENTER/q still work over SSH; headless (systemd, no TTY) runs wake-only and this is what
# makes robot.service usable. The wake word only STARTS capture -- the EXPLORE/FIND autonomy gate is
# separate and still required. Reliable always-listening uses sounddevice/PortAudio (added by
# install_stack.sh); the COMMAND capture still uses arecord on ROBOT_MIC above. A missing/unloadable
# .onnx model means LIVE has no trigger (the brain exits at startup); ENTER works only in --dry.
ROBOT_WAKEWORD_ENABLE=1
ROBOT_WAKEWORD_MODEL=~/LocalAiRobot/models/hey_jarvis.onnx   # stock+reliable default; custom hey_richard.onnx also in models/. missing/unloadable -> LIVE has no trigger (use --dry)
ROBOT_WAKEWORD_THRESHOLD=0.5        # stock hey_jarvis scores high; 0.5 = reference default (lower toward 0.3 only if it misses you)
ROBOT_WAKEWORD_TRIGGER_LEVEL=1      # consecutive activations before firing (raise to 2 if false-firing)
ROBOT_WAKEWORD_COOLDOWN_S=2.0       # quiet window after a wake / after TTS, before re-listening
ROBOT_WAKEWORD_DEVICE=0
ROBOT_FAKE_WAKE=0                   # dry-run: 1 = auto-fire the wake word once (else type 'r' at the prompt)

# ---- Audio cues / earcons (ack / greeting / thinking; see brain/sounds.py) ----
# Non-verbal feedback so a slow think/look isn't silent. WAVs live under <ROBOT_SOUNDS_DIR>/<cat>_sounds/
# (greeting_sounds / ack_sounds / thinking_sounds / error_sounds). Played via aplay under the same
# half-duplex audio_lock as TTS, so they never garble speech. Empty dirs = silent no-op.
ROBOT_SOUNDS_ENABLE=1
ROBOT_SOUNDS_DIR=                   # default: <repo>/sounds
ROBOT_SOUNDS_DEVICE=                # USB speaker ALSA card for `aplay -D` (e.g. plughw:2,0); empty = default
ROBOT_SOUNDS_GREETING=1             # play once on boot/arm (audible "stack is up", vital headless)
ROBOT_SOUNDS_ACK=1                  # short blip on wake / command accepted
ROBOT_SOUNDS_THINKING=1             # looped tone WHILE the model runs (proof-of-life on slow vision)
ROBOT_SOUNDS_ERROR=1                # on obstacle / LLM error (fire-and-forget; never delays the stop)
ROBOT_THINKING_LEAD_MS=500          # stay silent this long before the first thinking clip (fast turns)
ROBOT_THINKING_GAP_MS=0             # gap between looped thinking clips

# ---- Animated faces (optional PNG sequences; see brain/face.py) ----
# Drop frames in <ROBOT_FACE_FRAMES_DIR>/<state>/NN.png. >=2 frames animate; 1 = static still;
# none = the built-in procedural face (so with no faces/ dir, the face behaves exactly as before).
ROBOT_FACE_FRAMES_DIR=              # default: brain/faces
ROBOT_FACE_FPS=4                    # default frame rate for looping states (talking runs faster; turing capped)
