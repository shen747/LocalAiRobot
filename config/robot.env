# ---- AI stack (replace YOUR_USER with your Linux username) ----
ROBOT_MODEL=gemma3:4b
ROBOT_OLLAMA_URL=http://localhost:11434/api/generate
ROBOT_WHISPER_BIN=/home/YOUR_USER/whisper.cpp/build/bin/whisper-cli
ROBOT_WHISPER_MODEL=/home/YOUR_USER/whisper.cpp/models/ggml-base.en.bin
ROBOT_PIPER_BIN=/home/YOUR_USER/piper/piper/piper
ROBOT_PIPER_VOICE=/home/YOUR_USER/piper/en_US-lessac-medium.onnx
ROBOT_MIC=plughw:1,0
ROBOT_RECORD_SECS=4
ROBOT_TMPDIR=/dev/shm

# ---- PCA9685 PWM channels (which output the ESC and steering servo are wired to) ----
ROBOT_PCA9685_CHANNELS=16
ROBOT_ESC_CHANNEL=0
ROBOT_STEER_CHANNEL=1

# ---- Steering servo (degrees). Calibrate CENTER so the wheels point dead ahead, then ----
# ---- nudge LEFT/RIGHT until the wheels turn fully WITHOUT the linkage binding/buzzing. ----
ROBOT_STEER_CENTER=90
ROBOT_STEER_LEFT=55
ROBOT_STEER_RIGHT=125

# ---- Throttle (ESC). Keep the cap low on a heavy crawler so the LLM lag isn't dangerous. ----
ROBOT_MAX_THROTTLE=0.35
ROBOT_THROTTLE_INVERT=0      # set to 1 if FORWARD/REVERSE come out swapped
ROBOT_ESC_ARM_SECS=3         # neutral hold at startup so the ESC arms (it will beep)

# ---- Forward obstacle gate (HC-SR04 on Pi GPIO; ECHO MUST be level-shifted to 3.3V) ----
ROBOT_OBSTACLE_CM=30
ROBOT_TRIG_PIN=23            # BCM GPIO number
ROBOT_ECHO_PIN=24           # BCM GPIO number (via level shifter / divider)

# ---- Software failsafe: hard cap on how long one command may keep the motor running ----
ROBOT_MAX_MOVE_MS=5000
