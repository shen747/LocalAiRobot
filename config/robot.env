# ---- Mode (bench dry-run) ----
# 1 = no PCA9685 / ESC (Electronic Speed Controller) / servo / sensors needed. driver.py swaps in fakes and logs every
# intended GPIO/PWM/I2C action to the console, so you can verify voice -> model -> hardware
# mapping on an unwired Pi (or a laptop) before building the chassis. ROBOT_SIMULATE is an alias.
ROBOT_DRY_RUN=0
ROBOT_FAKE_DISTANCE_CM=200   # dry-run synthetic forward distance; set <30 to make the gate trip

# Stationary / tabletop mode: run fully LIVE (wake word, voice, camera, sensors, RAG, face) but the
# ESC + steering get NO PWM -- the console still shows the throttle/steer commands (like dry-run) yet
# the WHEELS NEVER MOVE. Talk to the assembled car on a desk without it driving off. Needs
# ROBOT_DRY_RUN=0 (dry-run already fakes everything). 0 = normal driving.
ROBOT_MOTORS_OFF=0

# ---- AI stack: speech in/out + the LOCAL model (replace YOUR_USER with your Linux username) ----
# whisper (STT) and piper (TTS) are ALWAYS local. ROBOT_MODEL / ROBOT_OLLAMA_URL / keepalive / num_ctx
# apply only when ROBOT_AI_BACKEND=local (see the "AI BACKEND" section below to use remote Gemini).
ROBOT_MODEL=gemma4:e4b-it-qat   # 4-bit QAT text/intent brain (E4B: more capable than E2B -- better at REMEMBER/recall -- but slower; swap to gemma4:e2b-it-qat for speed). vision is separate -> ROBOT_VISION_MODEL
ROBOT_OLLAMA_URL=http://localhost:11434/api/generate
ROBOT_LLM_TIMEOUT_S=120     # text-intent call timeout; raise if the first-command cold model load times out
ROBOT_WHISPER_BIN=/home/YOUR_USER/whisper.cpp/build/bin/whisper-cli
ROBOT_WHISPER_MODEL=/home/YOUR_USER/whisper.cpp/models/ggml-base.en.bin
ROBOT_PIPER_BIN=/home/YOUR_USER/piper/piper/piper
ROBOT_PIPER_VOICE=/home/YOUR_USER/piper/en_US-lessac-medium.onnx
ROBOT_MIC=plughw:CARD=Device,DEV=0    # command capture (arecord). BY NAME (not card number) so adding USB audio / a reboot can't shift it; find your id with `arecord -l`
ROBOT_RECORD_SECS=4
ROBOT_TMPDIR=/dev/shm

# ---- Phone command endpoint (HTTP) -- command the robot from your phone over Wi-Fi ----
# A tiny token-secured HTTP server runs INSIDE the brain (run_me.sh unchanged), so your phone (Android HTTP
# Shortcuts / iOS Shortcuts) can POST a dictated text command to http://<hostname>.local:PORT/speak -> the
# SAME brain the wake word uses. The robot ACTS + SPEAKS the reply AND returns it as JSON. ON BY DEFAULT;
# first run auto-generates ROBOT_HTTP_TOKEN and prints the ready URL. Setup + security: docs/http_setup.md.
ROBOT_HTTP_ENABLE=1          # 0 = off. On by default; starts with every brain launch.
ROBOT_HTTP_PORT=8080         # http://<hostname>.local:PORT/speak
ROBOT_HTTP_TOKEN=            # shared secret the phone MUST send (X-Robot-Token header or ?token=). EMPTY -> auto-generated + saved here on first run.
ROBOT_HTTP_ALLOW_CAMERA=0    # 0 = block camera actions (look around / find / remember) over HTTP so a stolen token can't peek; 1 = allow them.

# ============================================================================
#  AI BACKEND -- where the "brain" runs: local Ollama (default) or remote Gemini
#  Flips BOTH the text-intent model AND the camera/vision model. Speech (whisper
#  STT / piper TTS), sensors, motors, face and the wake word stay LOCAL either way.
#    local  = Ollama on the Pi, fully OFFLINE (uses the AI stack above).
#    gemini = Google Gemini, REMOTE -- needs network + an API key, and camera
#             frames leave the device. Get a key + setup: docs/gemini-setup.md
# ============================================================================
ROBOT_AI_BACKEND=local          # local | gemini

# ---- Remote Gemini (only used when ROBOT_AI_BACKEND=gemini) ----
ROBOT_GEMINI_API_KEY=           # Google AI Studio key; REQUIRED for gemini; keep secret. How to get one -> docs/gemini-setup.md
ROBOT_GEMINI_MODEL=gemini-2.5-flash       # remote text/intent model
ROBOT_GEMINI_VISION_MODEL=      # remote vision model; empty -> reuse ROBOT_GEMINI_MODEL (Gemini is multimodal)
ROBOT_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta   # API base; override for a proxy/region

# ---- PCA9685 PWM channels (which output the ESC (Electronic Speed Controller) and steering servo are wired to) ----
ROBOT_PCA9685_CHANNELS=16
ROBOT_ESC_CHANNEL=0
ROBOT_STEER_CHANNEL=1

# ---- Steering servo (degrees). Calibrate CENTER so the wheels point dead ahead, then ----
# ---- nudge LEFT/RIGHT until the wheels turn fully WITHOUT the linkage binding/buzzing. ----
ROBOT_STEER_CENTER=95
ROBOT_STEER_LEFT=30
ROBOT_STEER_RIGHT=135

# ---- Throttle (ESC). Speed 1..100 maps onto floor..ceil, which are the ACTUAL throttle values written
# (1500us=0.0, 2000us=1.00, 1000us=-1.00). FORWARD floor/ceil sit ABOVE neutral; REVERSE floor/ceil sit
# BELOW it -- so on an OFFSET-neutral ESC (see ROBOT_ESC_NEUTRAL) the reverse values are just-below-neutral.
# TUNE on the bench (esc.throttle=...): FLOOR = the value where it JUST crawls, CEIL = your top speed.
ROBOT_ESC_FWD_FLOOR=0.45     # FORWARD crawl -- just above neutral, where it just starts pulling (0.45=1725us)
ROBOT_ESC_FWD_CEIL=1.00      # FORWARD full speed (lower = slower, safer indoors)
ROBOT_ESC_REV_FLOOR=0.20     # REVERSE crawl -- just BELOW neutral (0.20=1600us with neutral 0.35). NOT a negative!
ROBOT_ESC_REV_CEIL=0.10      # REVERSE full -- deeper below neutral (LOWER than floor; go negative for faster)
ROBOT_THROTTLE_INVERT=0      # set to 1 if FORWARD/REVERSE come out swapped (or just swap the 2 motor wires)
ROBOT_DRIVE_CRAWL_SPEED=5    # crawl-by-default: normal DRIVE commands ("come forward"/"follow me") are capped to this speed, so they sit near the FWD/REV FLOOR (your bench crawl). Only saying fast/quick/hurry lets speed climb to 100.
ROBOT_ESC_ARM_SECS=3         # how long the brain holds neutral at startup so the ESC arms. Have the ESC
                             # powered ON while it holds neutral (see ROBOT_ESC_NEUTRAL); wait for the long beep.
# ESC neutral: the throttle the driver RESTS + STOPS at -- and holding it also ARMS the ESC. Most ESCs
# use 0.0 (1500us). But some are OFFSET: on one bench ESC, 0.0/1500us was a slow REVERSE (it crept) and it
# only truly stopped -- and armed (long "ready" beep, wheels dead still) -- at 0.25/1625us. Find yours by
# sweeping: the value where the wheels sit DEAD STILL and it gives the long beep. Forward/reverse floors/
# ceils above stay absolute. Keep the ESC powered when the brain starts so it sees this and arms.
ROBOT_ESC_NEUTRAL=0.35       # 0.0 = 1500us. This build's WP-1060 arms + stops at 0.35 (1675us). It DRIFTS -- re-sweep if arming stops.

# ---- Reverse mode ----
# THIS BUILD uses a crawler ESC with DIRECT reverse (set on its program card) + a drag-brake stop, so a
# single reverse command reverses immediately -- keep DOUBLETAP=0. Set DOUBLETAP=1 only for an old-style
# F/B/R ESC where reverse needs a "double-click": the driver then auto-taps reverse->neutral->reverse.
ROBOT_ESC_REVERSE_DOUBLETAP=0
ROBOT_ESC_REV_BRAKE_MS=400   # (F/B/R only) tap1 length the ESC reads as a brake
ROBOT_ESC_REV_GAP_MS=300     # (F/B/R only) neutral gap between the two taps

# ---- Forward obstacle gate (HC-SR04P on Pi GPIO; 3.3V, ECHO Pi-safe, no level shifter) ----
ROBOT_OBSTACLE_CM=30
ROBOT_TRIG_PIN=23            # BCM GPIO number
ROBOT_ECHO_PIN=24           # BCM GPIO number (HC-SR04P ECHO is 3.3V; a bare HC-SR04 needs a divider)

# ---- Side ultrasonic sensors (semi-hex array; all HC-SR04P at 3.3V, ECHO Pi-safe) ----
ROBOT_LEFT_TRIG_PIN=5
ROBOT_LEFT_ECHO_PIN=6
ROBOT_RIGHT_TRIG_PIN=20
ROBOT_RIGHT_ECHO_PIN=21
ROBOT_SIDE_OBSTACLE_CM=25    # explore steering-avoid threshold for the left/right beams
ROBOT_FAKE_LEFT_CM=200       # dry-run synthetic left distance
ROBOT_FAKE_RIGHT_CM=200      # dry-run synthetic right distance

# ---- Software failsafe: hard cap on how long one command may keep the motor running ----
ROBOT_MAX_MOVE_MS=5000

# ---- Camera (IMX219 via picamera2: Pi Camera V2 NoIR OR Arducam IMX219 8MP -- same sensor, no code change) ----
# ---- + vision (dedicated moondream VLM, ROBOT_VISION_MODEL) ----
ROBOT_CAMERA_ENABLE=1
ROBOT_CAMERA_SIZE=512        # square letterbox target before base64 (keeps the VLM to one image crop)
ROBOT_CAMERA_WARMUP_S=1.0    # let auto-exposure / white-balance settle before the capture
ROBOT_VISION_TIMEOUT_S=600   # Ollama image call is SLOW on the Pi 5 CPU (tens of s to minutes)
ROBOT_FAKE_VISION=           # dry-run scripted sighting "target:horizontal:distance:confidence" (e.g. sofa:left:near:0.9)

# ---- Face screen: USB-C serial panel (turing) OR a DSI/HDMI screen e.g. Freenove 5" 800x480 (framebuffer) ----
ROBOT_FACE_ENABLE=1
ROBOT_FACE_BACKEND=auto      # auto | turing (USB-C serial) | framebuffer (DSI/HDMI -> /dev/fb0) | simulated. auto tries turing->framebuffer->simulated
ROBOT_FACE_PORT=AUTO         # turing only: serial port, or /dev/ttyACM0
ROBOT_FACE_REVISION=A        # turing only: A (Turing/UsbPCMonitor 320x480) | B (XuanFang) -- confirm via the lib's simple-program.py
ROBOT_FACE_WIDTH=320         # turing only: panel geometry. framebuffer auto-reads size+depth from the kernel (Freenove 800x480, 32bpp handled)
ROBOT_FACE_HEIGHT=480        # turing only (see above)
ROBOT_FACE_BRIGHTNESS=80
ROBOT_FACE_LIB=~/turing-smart-screen-python   # cloned by scripts/install_stack.sh
ROBOT_FACE_DUMP=             # optional dir to save rendered face PNGs (bench debugging)

# ---- Autonomy: explore / find behaviour (only runs if a trigger phrase is in the transcript) ----
ROBOT_EXPLORE_TRIGGERS="explore,look around,have a look,take a look,find,look for,search for,where is,go to,go towards,move towards,move toward,head towards"
ROBOT_EXPLORE_MAX_ITERS=6    # FIND: max look->step iterations before giving up
ROBOT_EXPLORE_STEP_MS=900    # FIND: forward step toward a sighted target
ROBOT_SCAN_STEP_MS=700       # arc-scan nudge when the target/scene isn't framed yet
ROBOT_EXPLORE_SPEED=15       # throttle 0-100 used during explore/find (kept to a slow crawl)
ROBOT_EXPLORE_SCANS=3        # EXPLORE ("look around"): how many arc-scan looks to take
ROBOT_FIND_CONFIDENCE=0.55   # min vision confidence to act on a sighting
ROBOT_APPROACH_CM=40         # treat the target as reached when the forward beam is closer than this

# ---- Environment memory (SQLite; survives reboots; summarised back into the prompt) ----
ROBOT_MEMORY_DB=~/.localairobot/memory.db
ROBOT_MEMORY_MAX_CONTEXT=8   # recent distinct objects fed back to the model

# ---- Model orchestration (warmup + keep-alive + shared model lock; see brain/inference.py) ----
# Text-intent and vision share ONE Ollama model server; a single in-process lock serialises them
# (so two generates never collide) and keep-alive stops Ollama evicting the model between commands.
ROBOT_WARMUP=1               # prime the model at boot so the FIRST command isn't a slow cold load
ROBOT_OLLAMA_KEEPALIVE=30m   # keep the model resident: '30m', '-1' = forever, '' = Ollama default (~5m)
ROBOT_NUM_CTX=4096           # cap Ollama's KV-cache context (Gemma 4 defaults to 128K -- way more than
                             # short commands need). Smaller = faster + less RAM on the Pi. 0 = Ollama default.

# ---- Dedicated vision model (decouples vision latency from the text brain) ----
# Vision runs on its OWN VLM, separate from ROBOT_MODEL. Default 'moondream' (pulled by
# install_stack.sh) -- small/fast, light on the 16GB Pi. KEEP THIS SET: empty falls back to sharing
# ROBOT_MODEL, which is slower (and only works at all if THAT model can see). moondream is the safe pick.
# To switch the VLM: `ollama pull <new>`, set it here, then re-source.
ROBOT_VISION_MODEL=moondream

# ---- Wake word (openWakeWord; ON by default -> always-listening) ----
# The robot listens continuously and wakes on the phrase set by ROBOT_WAKEWORD_MODEL (stock "hey
# jarvis" by default; a custom "hey richard" also ships in models/), then records a command like the
# ENTER flow. ENTER/q still work over SSH; headless (systemd, no TTY) runs wake-only and this is what
# makes robot.service usable. The wake word only STARTS capture -- the EXPLORE/FIND autonomy gate is
# separate and still required. Reliable always-listening uses sounddevice/PortAudio (added by
# install_stack.sh); the COMMAND capture still uses arecord on ROBOT_MIC above. A missing/unloadable
# .onnx model means LIVE has no trigger (the brain exits at startup); ENTER works only in --dry.
ROBOT_WAKEWORD_ENABLE=1
ROBOT_WAKEWORD_MODEL=~/LocalAiRobot/models/hey_jarvis.onnx   # stock+reliable default; custom hey_richard.onnx also in models/. missing/unloadable -> LIVE has no trigger (use --dry)
ROBOT_WAKEWORD_THRESHOLD=0.4        # 0.4 (was 0.5): some 'hey jarvis' attempts scored 0.35-0.48. ALSO check mic CLIPPING -- if `loudest` nears 32767 the score collapses; lower mic gain (amixer) so loudest sits mid-scale
ROBOT_WAKEWORD_TRIGGER_LEVEL=1      # consecutive activations before firing (raise to 2 if false-firing)
ROBOT_WAKEWORD_COOLDOWN_S=2.0       # quiet window after a wake / after TTS, before re-listening
ROBOT_WAKEWORD_DEVICE=PnP           # WAKE mic (PortAudio): a unique bit of the mic's name ("USB PnP Sound Device") -- by-name survives card renumbering; empty = default input
ROBOT_FAKE_WAKE=0                   # dry-run: 1 = auto-fire the wake word once (else type 'r' at the prompt)

# ---- Audio cues / earcons (greeting / wake_ack / ack / thinking / error; see brain/sounds.py) ----
# Non-verbal feedback so a slow think/look isn't silent. WAVs live under <ROBOT_SOUNDS_DIR>/<folder>/
# (greeting_sounds / wake_word_ack / ack_sounds / thinking_sounds / error_sounds). Played via aplay under
# the same half-duplex audio_lock as TTS, so they never garble speech. Empty dirs = silent no-op.
ROBOT_SOUNDS_ENABLE=1
ROBOT_SOUNDS_DIR=                   # default: <repo>/sounds
ROBOT_SOUNDS_DEVICE=plughw:CARD=UACDemoV10,DEV=0   # EARCONS only (the VOICE uses the ALSA default -> ~/.asoundrc). Any USB speaker, by name (set CARD= from `aplay -l`; a USB-powered Naciffo 2 etc. is fine); empty = default
ROBOT_SOUNDS_GREETING=1             # play once on boot/arm (audible "stack is up", vital headless)
ROBOT_SOUNDS_WAKE_ACK=1             # "yes?/hi" the instant the WAKE WORD fires (wake_word_ack/) -- responding to being summoned
ROBOT_SOUNDS_ACK=1                  # "got it/on it" after a SPOKEN COMMAND is accepted (ack_sounds/)
ROBOT_SOUNDS_THINKING=1             # looped spoken cue WHILE the model runs (proof-of-life on slow vision)
ROBOT_SOUNDS_ERROR=1                # on obstacle / LLM error (fire-and-forget; never delays the stop)
ROBOT_THINKING_LEAD_MS=500          # stay silent this long before the first thinking cue (fast turns)
ROBOT_THINKING_REPEAT_S=20          # seconds between thinking cues; 0 = play it ONCE (spoken cues shouldn't repeat back-to-back; the face shows it's still thinking)

# ---- Animated faces (optional PNG sequences; see brain/face.py) ----
# Drop frames in <ROBOT_FACE_FRAMES_DIR>/<state>/NN.png. >=2 frames animate; 1 = static still;
# none = the built-in procedural face (so with no faces/ dir, the face behaves exactly as before).
ROBOT_FACE_FRAMES_DIR=              # default: brain/faces
ROBOT_FACE_FPS=4                    # default frame rate for looping states (talking runs faster; turing capped)
