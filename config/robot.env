# ---- Mode (bench dry-run) ----
# 1 = no PCA9685 / ESC / servo / sensors needed. driver.py swaps in fakes and logs every
# intended GPIO/PWM/I2C action to the console, so you can verify voice -> model -> hardware
# mapping on an unwired Pi (or a laptop) before building the chassis. ROBOT_SIMULATE is an alias.
ROBOT_DRY_RUN=0
ROBOT_FAKE_DISTANCE_CM=200   # dry-run synthetic forward distance; set <30 to make the gate trip

# ---- AI stack (replace YOUR_USER with your Linux username) ----
ROBOT_MODEL=gemma3:4b
ROBOT_OLLAMA_URL=http://localhost:11434/api/generate
ROBOT_LLM_TIMEOUT_S=120     # text-intent call timeout; raise if the first-command cold model load times out
ROBOT_WHISPER_BIN=/home/YOUR_USER/whisper.cpp/build/bin/whisper-cli
ROBOT_WHISPER_MODEL=/home/YOUR_USER/whisper.cpp/models/ggml-base.en.bin
ROBOT_PIPER_BIN=/home/YOUR_USER/piper/piper/piper
ROBOT_PIPER_VOICE=/home/YOUR_USER/piper/en_US-lessac-medium.onnx
ROBOT_MIC=plughw:1,0
ROBOT_RECORD_SECS=4
ROBOT_TMPDIR=/dev/shm

# ---- PCA9685 PWM channels (which output the ESC and steering servo are wired to) ----
ROBOT_PCA9685_CHANNELS=16
ROBOT_ESC_CHANNEL=0
ROBOT_STEER_CHANNEL=1

# ---- Steering servo (degrees). Calibrate CENTER so the wheels point dead ahead, then ----
# ---- nudge LEFT/RIGHT until the wheels turn fully WITHOUT the linkage binding/buzzing. ----
ROBOT_STEER_CENTER=90
ROBOT_STEER_LEFT=55
ROBOT_STEER_RIGHT=125

# ---- Throttle (ESC). Keep the cap low on a heavy crawler so the LLM lag isn't dangerous. ----
ROBOT_MAX_THROTTLE=0.35
ROBOT_THROTTLE_INVERT=0      # set to 1 if FORWARD/REVERSE come out swapped
ROBOT_ESC_ARM_SECS=3         # neutral hold at startup so the ESC arms (it will beep)

# ---- Forward obstacle gate (HC-SR04P on Pi GPIO; 3.3V, ECHO Pi-safe, no level shifter) ----
ROBOT_OBSTACLE_CM=30
ROBOT_TRIG_PIN=23            # BCM GPIO number
ROBOT_ECHO_PIN=24           # BCM GPIO number (HC-SR04P ECHO is 3.3V; a bare HC-SR04 needs a divider)

# ---- Side ultrasonic sensors (semi-hex array; all HC-SR04P at 3.3V, ECHO Pi-safe) ----
ROBOT_LEFT_TRIG_PIN=5
ROBOT_LEFT_ECHO_PIN=6
ROBOT_RIGHT_TRIG_PIN=20
ROBOT_RIGHT_ECHO_PIN=21
ROBOT_SIDE_OBSTACLE_CM=25    # explore steering-avoid threshold for the left/right beams
ROBOT_FAKE_LEFT_CM=200       # dry-run synthetic left distance
ROBOT_FAKE_RIGHT_CM=200      # dry-run synthetic right distance

# ---- Software failsafe: hard cap on how long one command may keep the motor running ----
ROBOT_MAX_MOVE_MS=5000

# ---- Camera (Pi Camera V2 NoIR via picamera2) + multimodal vision (same gemma3:4b) ----
ROBOT_CAMERA_ENABLE=1
ROBOT_CAMERA_SIZE=512        # square letterbox target before base64 (keeps Gemma3 to one crop)
ROBOT_CAMERA_WARMUP_S=1.0    # let auto-exposure / white-balance settle before the capture
ROBOT_VISION_TIMEOUT_S=600   # Ollama image call is SLOW on the Pi 5 CPU (tens of s to minutes)
ROBOT_FAKE_VISION=           # dry-run scripted sighting "target:horizontal:distance:confidence" (e.g. sofa:left:near:0.9)

# ---- Face screen (3.5" USB-C panel; auto-falls back to DSI/HDMI framebuffer, else simulated) ----
ROBOT_FACE_ENABLE=1
ROBOT_FACE_BACKEND=auto      # auto | turing | framebuffer | simulated
ROBOT_FACE_PORT=AUTO         # or /dev/ttyACM0
ROBOT_FACE_REVISION=A        # A (Turing/UsbPCMonitor 320x480) | B (XuanFang) -- confirm via the lib's simple-program.py
ROBOT_FACE_WIDTH=320
ROBOT_FACE_HEIGHT=480
ROBOT_FACE_BRIGHTNESS=80
ROBOT_FACE_LIB=~/turing-smart-screen-python   # cloned by scripts/install_stack.sh
ROBOT_FACE_DUMP=             # optional dir to save rendered face PNGs (bench debugging)

# ---- Autonomy: explore / find behaviour (only runs if a trigger phrase is in the transcript) ----
ROBOT_EXPLORE_TRIGGERS=explore,look around,have a look,take a look,find,look for,search for,where is,go to,go towards,move towards,move toward,head towards
ROBOT_EXPLORE_MAX_ITERS=6    # FIND: max look->step iterations before giving up
ROBOT_EXPLORE_STEP_MS=900    # FIND: forward step toward a sighted target
ROBOT_SCAN_STEP_MS=700       # arc-scan nudge when the target/scene isn't framed yet
ROBOT_EXPLORE_SPEED=30       # throttle 0-100 used during explore/find (kept low)
ROBOT_EXPLORE_SCANS=3        # EXPLORE ("look around"): how many arc-scan looks to take
ROBOT_FIND_CONFIDENCE=0.55   # min vision confidence to act on a sighting
ROBOT_APPROACH_CM=40         # treat the target as reached when the forward beam is closer than this

# ---- Environment memory (SQLite; survives reboots; summarised back into the prompt) ----
ROBOT_MEMORY_DB=~/.localairobot/memory.db
ROBOT_MEMORY_MAX_CONTEXT=8   # recent distinct objects fed back to the model
