@startuml basic_control_flow
' LocalAiRobot — how a spoken command becomes action (everything runs on the on-board computer: Pi 5 / Jetson).
' This source lives next to its render. Regenerate in place (writes basic_control_flow.png here):
'   plantuml -tpng docs/images/basic_control_flow.puml
' No Graphviz needed: !pragma layout smetana uses PlantUML's pure-Java layout engine.
'
' Deliberately plain-English labels (no part numbers / bus jargon). Stages read TOP-TO-BOTTOM and are
' grouped by COLOUR, not by boxes: smetana crashes (IllegalStateException in mincross) on nested
' "rectangle { }" containers once edges cross between them. Real boxed groups would need Graphviz.
'   COLOUR KEY:  blue = you / audio in   yellow = the AI   green = data it works with
'                orange = control logic   red = the motors/wheels
!pragma layout smetana
hide stereotype
title LocalAiRobot — how a spoken command becomes action (all on the robot's on-board computer)

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 16
skinparam TitleFontSize 20
skinparam ArrowColor #555555
skinparam ArrowFontColor #555555
skinparam ArrowFontSize 14
skinparam databaseBackgroundColor #D5E8D4
skinparam databaseBorderColor #82B366
skinparam rectangle {
  RoundCorner 12
  FontSize 16
  BorderThickness 1
  BackgroundColor<<io>> #DAE8FC
  BorderColor<<io>> #6C8EBF
  BackgroundColor<<model>> #FFF2CC
  BorderColor<<model>> #D6B656
  BackgroundColor<<data>> #D5E8D4
  BorderColor<<data>> #82B366
  BackgroundColor<<motor>> #F8CECC
  BorderColor<<motor>> #B85450
  BackgroundColor<<proc>> #FFE6CC
  BorderColor<<proc>> #D79B00
  BackgroundColor<<pad>> #FFFFFF
  BorderColor<<pad>> #FFFFFF
}
top to bottom direction

' ---------- 1. LISTEN (blue): the wake word comes first, THEN you speak ----------
rectangle "Wake word\n(\"hey jarvis\"; ENTER in --dry)" as wake <<io>>
rectangle "You speak a command\n(\"go forward\" / \"find the sofa\")" as voice <<io>>
rectangle "Speech to text" as stt <<model>>

' ---------- 2. THINK (yellow = AI, green = data) ----------
rectangle "AI brain\n(local language model)" as brain <<model>>
database "Memory\n(people / places / things it has\nseen, or that you taught it)" as mem
rectangle "Decision\nDrive · Stop · Explore · Find · Chat · Remember" as decision <<data>>

' ---------- 3. SEE (green) ----------
rectangle "Camera" as cam <<data>>
rectangle "Vision\n(describes what it sees)" as vision <<model>>

' ---------- 4. ACT (orange = control, red = motors) ----------
rectangle "Explore / find loop\n(agentic: look · decide · gated step)" as explore <<proc>>
rectangle "Ultrasonic sensors\n(front / left / right)" as sensors <<data>>
rectangle "Motion control\n(stops if something is < 30 cm ahead)" as motion <<proc>>
rectangle "Servo Driver" as servodrv <<io>>
rectangle "Electronic Speed Controller" as esc <<motor>>
rectangle "Drive motor" as dmotor <<motor>>
rectangle "Steering servo" as servo <<motor>>

' ---------- 5. RESPOND (blue / orange) ----------
rectangle "Speaks the reply" as tts <<proc>>
rectangle "Face screen\n(shows emotions)" as face <<io>>

' ---------- the main path: wake word -> you talk -> it understands -> it decides ----------
wake --> voice : wakes up, starts recording
voice --> stt : records a few seconds
stt --> brain : your words
mem --> brain : what it already knows
brain --> decision

' ---------- what the decision leads to ----------
decision --> motion : Drive / Stop
decision --> explore : Explore / Find
decision --> cam : Remember (take a photo)
decision --> tts : Chat reply (Say)
decision --> face : show an emotion

' ---------- seeing + remembering ----------
cam --> vision
vision --> mem : what it saw / who you named
explore --> cam : look around
explore --> motion : small, gated steps

' ---------- driving the wheels ----------
sensors --> motion : something ahead -> stop
motion --> tts : "Obstacle ahead."
motion --> servodrv : steering + throttle
servodrv --> esc : throttle
esc --> dmotor
servodrv --> servo : steering angle

' blank, invisible box (white-on-white) to leave breathing room below the last box (Drive motor)
rectangle " \n \n " as pad <<pad>>
dmotor -[hidden]-> pad

note bottom of brain
  Runs on-board (Pi 5 or Jetson) -- offline by default.
end note
@enduml
