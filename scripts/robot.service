# robot.service -- systemd unit to AUTO-START the brain on boot (headless, no SSH needed).
# Don't edit YOUR_USER by hand. Install it with:  ./scripts/run_me.sh --install-boot
#   (that fills in your username + repo path, copies this to /etc/systemd/system/, and enables it.)
# Remove it with:  ./scripts/run_me.sh --disable-boot
[Unit]
Description=Local AI Robot Brain (RC crawler)
After=ollama.service
Wants=ollama.service

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/LocalAiRobot/brain
# Load config/robot.env through bash, exactly like run_me.sh / a manual shell run. Do NOT switch
# this to systemd's EnvironmentFile= -- that parser keeps trailing "# comments" as part of each
# value, silently corrupting most settings in robot.env (numbers fall back to code defaults).
ExecStart=/bin/bash -c 'if [ -f /home/YOUR_USER/LocalAiRobot/config/robot.env ]; then set -a; . /home/YOUR_USER/LocalAiRobot/config/robot.env; set +a; fi; exec /home/YOUR_USER/LocalAiRobot/brain/.venv/bin/python /home/YOUR_USER/LocalAiRobot/brain/main.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
