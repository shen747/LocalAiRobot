# Python
brain/.venv/
__pycache__/
*.pyc
*.pyo

# Runtime audio scratch (normally written to /dev/shm, but guard anyway)
*.wav
# ...EXCEPTION: the spoken earcons under sounds/ ARE committed (you generate them with Piper on your PC --
# see sounds/README.md) so they ship with the repo. Drop your own WAVs there and they're tracked too.
!sounds/**/*.wav

# Runtime logs -- e.g. log.log from redirecting a run's console output to a file. (The detached-run
# log lives in ~/.localairobot/robot.log, outside the repo.)
*.log

# Model weights: too large to commit; fetched by scripts/install_stack.sh
*.bin
*.onnx
*.onnx.json
*.gguf
# ...EXCEPTION: the small (~200 KB) wake-word model(s) in models/ ARE committed -- they're the robot's
# default "hey richard" wake word (see models/README.md). Everything else .onnx stays ignored.
!models/*.onnx

# Local env override (config/robot.env IS committed as a template)
.env

# Personal secrets scratch (API keys etc.) -- NEVER commit. NB: config/robot.env is a COMMITTED template,
# so keep real keys out of it too -- set ROBOT_GEMINI_API_KEY on the robot only and don't `git add` that line.
*.secrets

# Editor/IDE
# .idea/
# .vscode/

# claude-mem writes session context into CLAUDE.md files — never commit them
# (a deliberate root CLAUDE.md, if ever wanted, can still be added with `git add -f`)
**/CLAUDE.md

# Scratch planning / review notes at the repo root (working documents, not part of the shipped repo).
# The pattern: a design doc is drafted here, and whatever survives it ships as an OPERATOR doc under docs/
# -- e.g. WEATHER.md became docs/weather.md. Leaving these merely untracked was the worst of both worlds:
# they showed up in every `git status` forever without ever being committed.
/PLAN.md
/REVIEW.md

# macOS Finder droppings. Harmless, invisible on Linux, and a nuisance in every diff if one ever lands.
.DS_Store

# Generated batch enrollment script (scripts/create_enrollments.sh output) -- personal (names + descriptions),
# regenerated on demand; never committed. The GENERATOR is committed; its OUTPUT is not.
/enroll_all.sh

